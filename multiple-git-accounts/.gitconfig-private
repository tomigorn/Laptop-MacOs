[user]
	name = tomigorn
	email = private-email@example.com
	signingkey = ~/.ssh/keys/git/gitHub-Tomigorn.pub

[core]
	sshCommand = ssh -i ~/.ssh/keys/git/gitHub-Tomigorn -o IdentitiesOnly=yes

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers-private

[commit]
	gpgsign = true

[tag]
	gpgsign = true
