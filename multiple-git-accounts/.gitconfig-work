[user]
	name = full name
	email = work-email
	signingkey = ~/.ssh/keys/git/gitLab-ETH.pub

[core]
	sshCommand = ssh -i ~/.ssh/keys/git/gitLab-ETH -o IdentitiesOnly=yes

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers-work

[commit]
	gpgsign = true

[tag]
	gpgsign = true
