; No [user] block here on purpose: identity comes from the folder (work/ or private/).
; A commit outside those trees fails on purpose: move the repo there, don't set user.name/user.email.

[includeIf "gitdir:~/development/work/"]
	path = ~/.gitconfig-work

[includeIf "gitdir:~/development/private/"]
	path = ~/.gitconfig-private
