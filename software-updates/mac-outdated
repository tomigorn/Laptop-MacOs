#!/opt/homebrew/bin/bash
# Lists outdated software from every update source on this Mac; --install installs the updates.
#   mac-outdated [--install | --help]
set -uo pipefail

PRIVILEGESCLI=/Applications/Privileges.app/Contents/MacOS/PrivilegesCLI
MSUPDATE="/Library/Application Support/Microsoft/MAU2.0/Microsoft AutoUpdate.app/Contents/MacOS/msupdate"
RUM=/usr/local/bin/RemoteUpdateManager
APP_DIRS=/Applications:$HOME/Applications
if [ "${MAC_OUTDATED_TEST:-}" = 1 ]; then  # the tests point these at stubs; never honoured otherwise, RUM runs under sudo
  PRIVILEGESCLI=${MAC_OUTDATED_PRIVILEGESCLI:-$PRIVILEGESCLI}
  MSUPDATE=${MAC_OUTDATED_MSUPDATE:-$MSUPDATE}
  RUM=${MAC_OUTDATED_RUM:-$RUM}
  APP_DIRS=${MAC_OUTDATED_APP_DIRS:-$APP_DIRS}
fi
STAMP="$HOME/.local/state/mac-outdated/last-check"
MIN_ADMIN_MINUTES=15
STEP_STATUS=""  # set by an install step instead of its exit code: missing, expired

SOURCES=(brew msupdate adobe mas macos pipx vscode sparkle unmanaged)
INSTALL_ORDER=(adobe mas brew msupdate pipx vscode macos)
declare -A LABELS=(
  [brew]="brew" [msupdate]="Microsoft AutoUpdate" [adobe]="Adobe" [mas]="App Store" [macos]="macOS"
  [pipx]="pipx" [vscode]="VS Code extensions" [sparkle]="Sparkle apps" [unmanaged]="Apps without an updater"
)
MANUAL_SOURCES=" sparkle unmanaged "
SELF_UPDATING=("Google Chrome" "Brave Browser" Firefox Discord Signal Obsidian Docker Steam zoom.us Element "Autodesk Fusion" "iStat Menus")
MANAGED_IDS=('com.apple.*' 'com.microsoft.*' 'com.adobe.*' 'com.jamf*' '*ethz*' 'corp.sap.privileges' 'nl.root3.support')
BREW_APPS=""
declare -A HINTS=(
  [brew]="mac-outdated --install" [msupdate]="mac-outdated --install" [adobe]="mac-outdated --install" [mas]="mac-outdated --install"
  [macos]="mac-outdated --install" [pipx]="mac-outdated --install" [vscode]="mac-outdated --install"
  [sparkle]="open the app" [unmanaged]="brew install --cask --adopt …"
)
RULE=$(printf '═%.0s' {1..58})
THIN=$(printf '─%.0s' {1..32})
COLOR=0

usage() {
  cat <<'EOF'
usage: mac-outdated [--install]
  (none)     check every source, print what is outdated (no admin needed)
  --install  install every available update (needs admin from the Privileges app, >= 15 min left)
  --help     this text
exit: 0 nothing outdated / all installed, 1 something outdated / something failed, 2 usage or admin precondition
EOF
}

# ── helpers ──────────────────────────────────────────────────────────────────
item() { printf '%s|%s|%s|%s|%s\n' "$1" "$2" "$3" "$4" "${5:-}"; }
# note <src> <text> [short result] [kind: ? unknown, – skipped] [summary hint]: without a short result the note gets a section
note() { printf '%s|%s|%s||%s|%s\n' "$1" "${3:-}" "${4:-}" "$2" "${5:-}"; }
check_failed() { note "$1" "$2" "check failed" "!" "check failed"; }  # check_failed <src> <text>: the source could not be checked

setup_color() {
  COLOR=0
  if [ "${MAC_OUTDATED_COLOR:-}" = always ]; then COLOR=1
  elif [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then COLOR=1
  fi
}
c() {  # c <sgr code> <text>: bold 1, dim 2, red 31, green 32, yellow 33
  if [ "$COLOR" -eq 1 ]; then printf '\033[%sm%s\033[0m' "$1" "$2"; else printf '%s' "$2"; fi
}
header() { printf '%s · %s\n\n' "$(c 1 "$1")" "$(date '+%Y-%m-%d %H:%M')"; }
section() {  # section <title> <detail>
  printf '\n%s\n %s%s\n%s\n' "$RULE" "$(c 1 "$1")" "${2:+ · $2}" "$RULE"
}
progress_start() {  # progress_start <label>: dots to a fixed column, the result follows on the same line
  local dots=$((29 - ${#1}))
  [ "$dots" -ge 2 ] || dots=2
  printf '  %s %s ' "$1" "$(printf '.%.0s' $(seq "$dots"))"
}
row() {  # row <name> <installed> <latest> <name width> <version width> [tag]
  printf '    %s %s  →  %s%s\n' "$(printf '%-*s' "$4" "$1")" "$(c 2 "$(printf '%-*s' "$5" "$2")")" "$(c 32 "$3")" "${6:+  $(c 33 "$6")}"
}
summary_row() {  # summary_row <label> <count> <hint>
  printf '  %-26s%s%s   %s\n' "$1" "$(printf '%*s' $((4 - ${#2})) '')" "$2" "$(c 2 "$3")"
}

older() {  # older <installed> <latest>: installed is strictly newer than latest, brew _N revisions ignored
  local i=$1 l=$2
  [[ $i =~ ^(.*)_[0-9]+$ ]] && i=${BASH_REMATCH[1]}
  [[ $l =~ ^(.*)_[0-9]+$ ]] && l=${BASH_REMATCH[1]}
  [ "$i" != "$l" ] && newer "$l" "$i"
}

plist_get() { plutil -extract "$2" raw -o - "$1" 2>/dev/null; }
app_version() { plist_get "$1/Contents/Info.plist" CFBundleShortVersionString; }

newer() {  # newer <installed> <latest>: latest is strictly newer
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$2" ]
}

all_apps() {
  local dirs d a
  IFS=: read -ra dirs <<< "$APP_DIRS"
  for d in "${dirs[@]}"; do
    for a in "$d"/*.app; do [ -d "$a" ] && printf '%s\n' "$a"; done
  done
}
find_app() {
  local a
  while IFS= read -r a; do
    [ "$(basename "$a" .app)" = "$1" ] && { printf '%s\n' "$a"; return 0; }
  done < <(all_apps)
  return 1
}
is_self_updating() {
  local s
  for s in "${SELF_UPDATING[@]}"; do [ "$s" = "$1" ] && return 0; done
  return 1
}
is_managed_id() {
  local p
  for p in "${MANAGED_IDS[@]}"; do
    # shellcheck disable=SC2053
    [[ $1 == $p ]] && return 0
  done
  return 1
}
is_brew_app() { grep -qixF "$1.app" <<< "$BREW_APPS"; }
load_brew_apps() {
  command -v brew >/dev/null || return 0
  BREW_APPS=$(brew info --cask --json=v2 --installed 2>/dev/null \
    | jq -r '.casks[].artifacts[]? | objects | .app? // empty | .[] | strings' 2>/dev/null)
}
code_cmd() {
  local c
  c=$(command -v code) && { printf '%s\n' "$c"; return 0; }
  c="$HOME/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
  [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
  return 1
}

# ── check_<src>: print src|name|installed|latest|note lines ──────────────────
check_brew() {
  command -v brew >/dev/null || { note brew "brew not installed" "skipped (brew not installed)" – "install brew"; return; }
  brew update --quiet >/dev/null 2>&1 || note brew "brew update failed, the list may be stale"
  local json
  json=$(brew outdated --greedy --json=v2 2>/dev/null) || { check_failed brew "brew outdated failed"; return; }
  jq -r '(.formulae | map(. + {kind: "formula"})) + (.casks | map(. + {kind: "cask"})) | .[] | select(.pinned | not)
    | "brew|\(.name)|\(.installed_versions | if type == "array" then last else . end)|\(.current_version)|\(.kind)"' <<< "$json" \
    || check_failed brew "could not read brew outdated output"
}

parse_msupdate() {
  sed -e $'s/\033\\[[0-9;]*[A-Za-z]//g' | tr '\r' '\n' | awk '
    function flush() { if (name != "") print name "|" (v == "" ? "?" : v); name = ""; v = "" }
    /Updates available:/ { on = 1; next }
    !on { next }
    { sub(/^[ \t]+/, ""); sub(/[ \t]+$/, "") }
    $0 == "" || /^Update Assistant/ || /^No updates/ { next }
    /^Version:/ { sub(/^Version:[ \t]*/, ""); split($0, f, " "); v = f[1]; next }
    /^[A-Za-z][A-Za-z ]*:/ { next }
    {
      flush(); name = $0
      if (match(name, / \([^)]*\)$/)) { v = substr(name, RSTART + 2, RLENGTH - 3); name = substr(name, 1, RSTART - 1) }
    }
    END { flush() }'
}
check_msupdate() {
  [ -x "$MSUPDATE" ] || { note msupdate "Microsoft AutoUpdate not installed" "skipped (msupdate not installed)" – "install Microsoft AutoUpdate"; return; }
  local out name version app inst
  out=$("$MSUPDATE" --list 2>&1) || { check_failed msupdate "msupdate --list failed"; return; }
  while IFS='|' read -r name version; do
    [ -n "$name" ] || continue
    inst=""
    app=$(find_app "$name") && inst=$(app_version "$app")
    item msupdate "$name" "${inst:-?}" "$version"
  done < <(parse_msupdate <<< "$out")
}

check_adobe() {
  [ -x "$RUM" ] || { note adobe "RemoteUpdateManager not installed" "skipped (RemoteUpdateManager not installed)" – "install RemoteUpdateManager"; return; }
  local out rc
  out=$("$RUM" --action=list 2>&1); rc=$?
  if grep -q "not launched with Admin" <<< "$out"; then
    note adobe "mac-outdated --install updates Adobe apps" "checked during --install"; return
  fi
  awk '
    /^\*+/ { on = 0 }
    /Following .*[Uu]pdates are applicable/ { on = 1; next }
    on && /^[ \t]*- / {
      sub(/^[ \t]*- /, ""); n = split($0, p, "/")
      if (n >= 2) print "adobe|" p[1] "|?|" p[2] "|"; else print "adobe|" $0 "|?|update|"
    }' <<< "$out"
  [ "$rc" -eq 0 ] || grep -q "Following" <<< "$out" || check_failed adobe "RemoteUpdateManager --action=list failed (exit $rc)"
}

check_mas() {
  command -v mas >/dev/null || { note mas "mas not installed: brew install mas" "skipped (mas not installed)" – "brew install mas"; return; }
  local json
  json=$(mas outdated --json 2>/dev/null) || { check_failed mas "mas outdated failed"; return; }
  jq -r 'select(type == "object" and .newVersion != null and (.name // "") != "")
    | "mas|\(.name)|\(.version // "?")|\(.newVersion)|"' <<< "$json" \
    || check_failed mas "could not read mas outdated output"
}

check_macos() {
  command -v softwareupdate >/dev/null || { note macos "softwareupdate not found" "skipped (softwareupdate not found)" – "softwareupdate missing"; return; }
  local out current
  out=$(softwareupdate --list 2>&1) || { check_failed macos "softwareupdate --list failed"; return; }
  current=$(sw_vers -productVersion 2>/dev/null)
  awk -v cur="$current" '
    /Title: / {
      t = $0; sub(/.*Title: /, "", t); sub(/, Version: .*/, "", t)
      v = $0; sub(/.*Version: /, "", v); sub(/,.*/, "", v)
      inst = (t ~ /^macOS/ && cur != "") ? cur : "?"
      print "macos|" t "|" inst "|" v "|" ($0 ~ /Action: restart/ ? "restart required" : "")
    }' <<< "$out"
}

check_pipx() {
  command -v pipx >/dev/null || { note pipx "pipx not installed" "skipped (pipx not installed)" – "brew install pipx"; return; }
  local json venv pkg inst latest
  json=$(pipx list --json 2>/dev/null) || { check_failed pipx "pipx list failed"; return; }
  while IFS=$'\t' read -r venv pkg inst src; do
    [ -n "$venv" ] || continue
    [[ "$src" == /* || "$src" == .* || "$src" == file:* ]] && continue  # local path install, nothing to look up
    latest=$(pipx runpip "$venv" index versions "$pkg" 2>/dev/null | head -n 1 | sed -nE 's/^.*\((.+)\)$/\1/p')
    [ -n "$latest" ] || { note pipx "$pkg: latest version lookup failed"; continue; }
    newer "$inst" "$latest" && item pipx "$pkg" "$inst" "$latest"
  done < <(jq -r '.venvs | to_entries[] | [.key, .value.metadata.main_package.package, .value.metadata.main_package.package_version, (.value.metadata.main_package.package_or_url // "")] | @tsv' <<< "$json")
}

check_vscode() {
  local code n
  code=$(code_cmd) || { note vscode "VS Code CLI not found" "skipped (code not found)" – "install the code CLI"; return; }
  n=$("$code" --list-extensions --show-versions 2>/dev/null | grep -c '@')
  note vscode "$n extensions, mac-outdated --install updates them" "$n extensions, updated during --install"
}

appcast_latest() {  # prints "S <newest shortVersionString>" and "V <newest version>" lines, beta channels skipped
  awk '
    { buf = buf " " $0 }
    END {
      n = split(buf, items, "</item>")
      for (i = 1; i <= n; i++) {
        s = items[i]
        if (s !~ /<item/ || s ~ /sparkle:channel/) continue
        if (match(s, /sparkle:shortVersionString="[^"]+"/) || match(s, /<sparkle:shortVersionString>[^<]+</))
          print "S " substr(s, RSTART + 28, RLENGTH - 29)
        if (match(s, /sparkle:version="[^"]+"/) || match(s, /<sparkle:version>[^<]+</))
          print "V " substr(s, RSTART + 17, RLENGTH - 18)
      }
    }' | sort -k1,1 -k2V | awk '{ last[$1] = $2 } END { for (k in last) print k, last[k] }'
}
check_sparkle() {
  local app name plist feed xml kind value short="" build="" inst latest
  while IFS= read -r app; do
    [ -d "$app/Contents/Frameworks/Sparkle.framework" ] || continue
    name=$(basename "$app" .app)
    is_brew_app "$name" && continue
    is_self_updating "$name" && continue
    plist="$app/Contents/Info.plist"
    feed=$(plist_get "$plist" SUFeedURL)
    [ -n "$feed" ] || continue
    xml=$(curl -fsSL --max-time 10 "$feed" 2>/dev/null) || { note sparkle "$name: appcast not reachable"; continue; }
    short="" build=""
    while read -r kind value; do
      case $kind in S) short=$value ;; V) build=$value ;; esac
    done < <(appcast_latest <<< "$xml")
    if [ -n "$short" ]; then inst=$(app_version "$app"); latest=$short
    elif [ -n "$build" ]; then inst=$(plist_get "$plist" CFBundleVersion); latest=$build
    else note sparkle "$name: no version in appcast"; continue
    fi
    [ -n "$inst" ] && newer "$inst" "$latest" && item sparkle "$name" "$inst" "$latest" "open $name to update"
  done < <(all_apps)
}

cask_token() { printf '%s' "$1" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9.-'; }
check_unmanaged() {
  command -v brew >/dev/null || return 0
  local app name id inst token version latest
  while IFS= read -r app; do
    name=$(basename "$app" .app)
    [ -d "$app/Contents/Frameworks/Sparkle.framework" ] && continue
    [ -d "$app/Contents/_MASReceipt" ] && continue
    is_brew_app "$name" && continue
    is_self_updating "$name" && continue
    id=$(plist_get "$app/Contents/Info.plist" CFBundleIdentifier)
    is_managed_id "$id" && continue
    inst=$(app_version "$app")
    [ -n "$inst" ] || continue
    token=$(cask_token "$name")
    [ -n "$token" ] || continue
    version=$(brew info --cask --json=v2 "$token" 2>/dev/null \
      | jq -r --arg a "$name.app" '.casks[0] | select([.artifacts[]? | objects | .app? // empty | .[] | strings] | index($a)) | .version' 2>/dev/null)
    latest=${version%%,*}
    [ -n "$latest" ] && [ "$latest" != latest ] || continue
    newer "$inst" "$latest" && item unmanaged "$name" "$inst" "$latest" "brew install --cask --adopt $token"
  done < <(all_apps)
}

self_updating_installed() {
  local s found=()
  for s in "${SELF_UPDATING[@]}"; do find_app "$s" >/dev/null && ! is_brew_app "$s" && found+=("$s"); done
  [ "${#found[@]}" -gt 0 ] || return 0
  local IFS=,
  printf '\n%s\n' "$(c 2 "updates itself on launch: $(sed 's/,/, /g' <<< "${found[*]}")")"
}

# ── check mode ───────────────────────────────────────────────────────────────
declare -A N_ITEMS N_NOTES N_FAILED SHORT KIND SHINT

analyze() {  # analyze <src> <lines>: fills the counters and the short result of the first note that has one
  local src=$1 s name inst latest extra hint
  N_ITEMS[$src]=0 N_NOTES[$src]=0 N_FAILED[$src]=0 SHORT[$src]="" KIND[$src]="" SHINT[$src]=""
  while IFS='|' read -r s name inst latest extra hint; do
    [ -n "$s" ] || continue
    if [ -n "$latest" ]; then N_ITEMS[$src]=$((N_ITEMS[$src] + 1)); continue; fi
    N_NOTES[$src]=$((N_NOTES[$src] + 1))
    [ "$inst" != "!" ] || N_FAILED[$src]=1
    if [ -n "$name" ] && [ -z "${SHORT[$src]}" ]; then SHORT[$src]=$name KIND[$src]=$inst SHINT[$src]=$hint; fi
  done <<< "$2"
}
result_text() {  # result_text <src>: the coloured short result for the progress line
  local src=$1
  if [ "${N_ITEMS[$src]}" -gt 0 ]; then printf '%s outdated' "${N_ITEMS[$src]}"
  elif [ -n "${SHORT[$src]}" ]; then
    case ${KIND[$src]} in
      "!") c 31 "${SHORT[$src]}" ;;
      "") printf '%s' "${SHORT[$src]}" ;;
      *) c 33 "${SHORT[$src]}" ;;
    esac
  elif [ "${N_NOTES[$src]}" -gt 0 ]; then c 33 "${N_NOTES[$src]} note$([ "${N_NOTES[$src]}" -gt 1 ] && echo s)"
  else c 32 "up to date"
  fi
}

detail_section() {  # detail_section <src> <lines>
  local src=$1 block=$2 s name inst latest extra hint n=0 nw=24 vw=1 tag group
  while IFS='|' read -r s name inst latest extra hint; do
    [ -n "$latest" ] || continue
    [ "${#name}" -le "$nw" ] || nw=${#name}
    [ "${#inst}" -le "$vw" ] || vw=${#inst}
  done <<< "$block"
  if [ "${N_ITEMS[$src]}" -gt 0 ]; then n="${N_ITEMS[$src]} outdated"; else n="${N_NOTES[$src]} note"; fi
  section "${LABELS[$src]}" "$n"
  local groups=("")
  [ "$src" = brew ] && groups=(formula cask)
  for group in "${groups[@]}"; do
    if [ -n "$group" ] && grep -q "|$group\$" <<< "$block"; then
      case $group in formula) printf '  formulae\n' ;; cask) printf '  casks\n' ;; esac
    fi
    while IFS='|' read -r s name inst latest extra hint; do
      [ -n "$latest" ] || continue
      [ "$src" != brew ] || [ "$extra" = "$group" ] || continue
      tag=""
      case $src in
        brew) older "$inst" "$latest" && tag="(older version: brew moved to the $(cut -d. -f1,2 <<< "$latest") line)" ;;
        macos) [ -z "$extra" ] || tag="($extra)" ;;
      esac
      row "$name" "$inst" "$latest" "$nw" "$vw" "$tag"
      case $src in sparkle|unmanaged) [ -z "$extra" ] || printf '      %s\n' "$(c 2 "$extra")" ;; esac
    done <<< "$block"
  done
  while IFS='|' read -r s name inst latest extra hint; do
    [ -z "$latest" ] && [ -n "$s" ] && printf '  %s\n' "$(c 33 "$extra")"
  done <<< "$block"
}

check_mode() {
  command -v jq >/dev/null || { echo "jq not found: brew install jq" >&2; exit 2; }
  load_brew_apps
  setup_color
  header "mac-outdated"
  local src block
  declare -A LINES
  for src in "${SOURCES[@]}"; do
    progress_start "${LABELS[$src]}"
    block=$("check_$src")
    LINES[$src]=$block
    analyze "$src" "$block"
    printf '%s\n' "$(result_text "$src")"
  done

  local outdated=0 manual=0 installable=0 nfailed=0 n
  for src in "${SOURCES[@]}"; do
    n=${N_ITEMS[$src]}
    nfailed=$((nfailed + N_FAILED[$src]))
    outdated=$((outdated + n))
    if [[ $MANUAL_SOURCES == *" $src "* ]]; then manual=$((manual + n)); else installable=$((installable + n)); fi
    if [ "$n" -gt 0 ] || { [ "${N_NOTES[$src]}" -gt 0 ] && [ -z "${SHORT[$src]}" ]; }; then
      detail_section "$src" "${LINES[$src]}"
    fi
  done
  self_updating_installed

  section "Summary" ""
  for src in "${SOURCES[@]}"; do
    if [ "${N_ITEMS[$src]}" -gt 0 ]; then summary_row "${LABELS[$src]}" "${N_ITEMS[$src]}" "${HINTS[$src]}"
    elif [ "${KIND[$src]}" = "?" ] || [ "${KIND[$src]}" = "–" ] || [ "${KIND[$src]}" = "!" ]; then summary_row "${LABELS[$src]}" "${KIND[$src]}" "${SHINT[$src]}"
    fi
  done
  if [ "$outdated" -gt 0 ] || [ "$nfailed" -gt 0 ]; then
    local rest=""
    [ "$outdated" -eq 0 ] || rest="$installable via --install · $manual by hand"
    [ "$nfailed" -eq 0 ] || rest+="${rest:+ · }$nfailed check$([ "$nfailed" -gt 1 ] && echo s) failed"
    printf '  %s\n' "$THIN"
    summary_row total "$outdated" "$rest"
  else
    printf '  %s\n' "$(c 32 "everything up to date")"
  fi
  [ "$installable" -gt 0 ] && printf '\n  %s\n' "$(c 1 "next: mac-outdated --install")"
  [ "$nfailed" -gt 0 ] || { mkdir -p "$(dirname "$STAMP")" && date +%s > "$STAMP"; }
  [ "$outdated" -eq 0 ] && [ "$nfailed" -eq 0 ]
}

# ── admin precondition ───────────────────────────────────────────────────────
admin_minutes_left() {  # parses "Administrator privileges expire in N minute(s)" from the status text
  [[ $1 =~ expire\ in\ ([0-9]+)\ minute ]] && echo "${BASH_REMATCH[1]}"
}
is_admin_status() { [[ $1 == *"has administrator privileges"* || $1 == *"Administrator privileges have been assigned"* ]]; }
require_admin() {
  local status left answer
  [ -x "$PRIVILEGESCLI" ] || { echo "Privileges app not found: $PRIVILEGESCLI"; return 1; }
  status=$("$PRIVILEGESCLI" --status 2>&1)
  if ! is_admin_status "$status"; then
    echo "Click Privileges (lock icon in the menu bar), then rerun mac-outdated --install"
    return 1
  fi
  if left=$(admin_minutes_left "$status"); then
    if [ "$left" -lt "$MIN_ADMIN_MINUTES" ]; then
      echo "only $left min of admin left, need $MIN_ADMIN_MINUTES: revert and click Privileges again"
      return 1
    fi
    echo "admin: $left min left"
  else
    echo "admin time left unknown"
    printf 'Continue anyway? [y/N] '
    read -r answer || answer=""
    [[ $answer == [yY]* ]] || return 1
  fi
}

still_admin() { is_admin_status "$("$PRIVILEGESCLI" --status 2>&1)"; }

# ── install_<src>: the tool's exit code; a step that does not run sets STEP_STATUS and returns 0 ──
install_macos() {  # runs on the terminal, not through a pipe: softwareupdate may ask for the owner password
  command -v softwareupdate >/dev/null || { STEP_STATUS=missing; return 0; }
  still_admin || { STEP_STATUS=expired; return 0; }
  local list rc
  list=$(softwareupdate --list 2>&1)
  sudo softwareupdate --install --all; rc=$?
  grep -q 'Action: restart' <<< "$list" && echo "    restart required: restart the Mac when it suits you"
  return "$rc"
}
install_adobe() {
  [ -x "$RUM" ] || { STEP_STATUS=missing; return 0; }
  still_admin || { STEP_STATUS=expired; return 0; }
  sudo "$RUM" --action=install
}
install_brew() {
  command -v brew >/dev/null || { STEP_STATUS=missing; return 0; }
  brew update || echo "brew update failed, upgrading anyway"
  brew upgrade --greedy
}
install_msupdate() {
  [ -x "$MSUPDATE" ] || { STEP_STATUS=missing; return 0; }
  "$MSUPDATE" --install
}
install_mas() {
  local mas
  mas=$(command -v mas) || { STEP_STATUS=missing; return 0; }
  still_admin || { STEP_STATUS=expired; return 0; }
  sudo "$mas" upgrade
}
install_pipx() {
  command -v pipx >/dev/null || { STEP_STATUS=missing; return 0; }
  pipx upgrade-all
}
install_vscode() {
  local code
  code=$(code_cmd) || { STEP_STATUS=missing; return 0; }
  "$code" --update-extensions
}

indent() {  # indents tool output as it arrives; a line without newline (a prompt) shows after a second
  local line rc mid=0
  while :; do
    IFS= read -r -t 1 line; rc=$?
    [ "$rc" -eq 0 ] && line=${line%$'\r'}
    line=${line//$'\r'/$'\n'    }
    if [ "$rc" -eq 0 ]; then
      [ "$mid" -eq 1 ] || printf '    '
      printf '%s\n' "$line"; mid=0
    elif [ "$rc" -gt 128 ]; then
      [ -n "$line" ] || continue
      [ "$mid" -eq 1 ] || printf '    '
      printf '%s' "$line"; mid=1
    else
      if [ -n "$line" ]; then [ "$mid" -eq 1 ] || printf '    '; printf '%s\n' "$line"
      elif [ "$mid" -eq 1 ]; then printf '\n'
      fi
      return 0
    fi
  done
}

install_mode() {
  setup_color
  header "mac-outdated --install"
  require_admin || exit 2
  echo "  sudo asks for your password for Adobe, App Store and macOS, and may ask again for later steps"
  sudo -v || { echo "sudo failed"; exit 2; }
  local src rc failed=0 label word
  local -A result
  local -i installed=0 nfailed=0 skipped=0
  for src in "${INSTALL_ORDER[@]}"; do
    label=${LABELS[$src]}
    printf '\n%s\n' "$(c 1 "── $label")"
    STEP_STATUS=""
    if [ "$src" = macos ]; then
      install_macos; rc=$?
    else
      "install_$src" > >(indent) 2>&1; rc=$?
      wait "$!"
    fi
    case $STEP_STATUS:$rc in
      missing:*) result[$src]="skipped ($src not installed)"; skipped+=1; word=$(c 33 "${result[$src]}") ;;
      expired:*) result[$src]="skipped (admin expired: click Privileges and rerun)"; skipped+=1; failed=1; word=$(c 33 "${result[$src]}") ;;
      :0) result[$src]=installed; installed+=1; word=$(c 32 installed) ;;
      *) result[$src]="failed (exit $rc)"; nfailed+=1; failed=1; word=$(c 31 "failed (exit $rc)") ;;
    esac
    progress_start "$label"
    printf '%s\n' "$word"
  done

  section "Summary" ""
  for src in "${INSTALL_ORDER[@]}"; do
    case ${result[$src]} in
      installed) word=$(c 32 installed) ;;
      skipped*) word=$(c 33 "${result[$src]}") ;;
      *) word=$(c 31 "${result[$src]}") ;;
    esac
    printf '  %-26s%s\n' "${LABELS[$src]}" "$word"
  done
  printf '  %s\n' "$THIN"
  local parts=()
  [ "$installed" -eq 0 ] || parts+=("$installed installed")
  [ "$nfailed" -eq 0 ] || parts+=("$nfailed failed")
  [ "$skipped" -eq 0 ] || parts+=("$skipped skipped")
  local joined=${parts[0]-} i
  for i in "${parts[@]:1}"; do joined+=" · $i"; done
  printf '  %-26s%s\n' total "$joined"
  exit "$failed"
}

main() {
  if [ "$(id -u)" -eq 0 ]; then
    echo "run mac-outdated --install as your own user, not with sudo: it asks for your password itself (brew must not run as root)" >&2
    exit 2
  fi
  case "${1:-}" in
    "") check_mode; exit $? ;;
    --install) [ $# -eq 1 ] || { usage >&2; exit 2; }; install_mode ;;
    -h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

[ "${BASH_SOURCE[0]}" != "$0" ] || main "$@"
