#!/opt/homebrew/bin/bash
# Lists outdated software from every update source on this Mac; --install installs the updates.
#   mac-outdated [--install | --version | --help]
set -uo pipefail

PRIVILEGESCLI=/Applications/Privileges.app/Contents/MacOS/PrivilegesCLI
MSUPDATE="/Library/Application Support/Microsoft/MAU2.0/Microsoft AutoUpdate.app/Contents/MacOS/msupdate"
RUM=/usr/local/bin/RemoteUpdateManager
SCRIPT_CMD=/usr/bin/script
SUDO=/usr/bin/sudo
SOFTWAREUPDATE=/usr/sbin/softwareupdate
STDIN_TTY=""
APP_DIRS=/Applications:$HOME/Applications
REPO_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd -P)
VERSION=$(cat "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/VERSION" 2>/dev/null) || VERSION=""
VERSION=${VERSION:-?}
if [ "${MAC_OUTDATED_TEST:-}" = 1 ]; then  # the tests point these at stubs; never honoured otherwise
  PRIVILEGESCLI=${MAC_OUTDATED_PRIVILEGESCLI:-$PRIVILEGESCLI}
  MSUPDATE=${MAC_OUTDATED_MSUPDATE:-$MSUPDATE}
  if [ -n "${MAC_OUTDATED_SUDO:-}" ] && [ "$MAC_OUTDATED_SUDO" != "$SUDO" ]; then  # what runs under sudo follows only a stub sudo
    SUDO=$MAC_OUTDATED_SUDO
    RUM=${MAC_OUTDATED_RUM:-$RUM}
    SOFTWAREUPDATE=${MAC_OUTDATED_SOFTWAREUPDATE:-$SOFTWAREUPDATE}
    SCRIPT_CMD=${MAC_OUTDATED_SCRIPT:-$SCRIPT_CMD}
  fi
  STDIN_TTY=${MAC_OUTDATED_STDIN_TTY:-}
  APP_DIRS=${MAC_OUTDATED_APP_DIRS:-$APP_DIRS}
  REPO_ROOT=${MAC_OUTDATED_REPO:-$REPO_ROOT}
fi
STAMP="$HOME/.local/state/mac-outdated/last-check"
LOG_DIR="$HOME/.local/state/mac-outdated/logs"
LOG_KEEP=20
LOG="" LOG_PID="" OUT_FD="" ERR_FD=""
TMP_DIR=""
MIN_ADMIN_MINUTES=15
MIN_STEP_ADMIN_MINUTES=2
STEP_STATUS=""  # set by an install step instead of its exit code: missing, uptodate, expired, "expires N", restart, unverified, stilloffered, unconfirmed
MACOS_FAILED=""
MACOS_STAGED=""  # macOS labels still offered after install because they wait for a restart

SOURCES=(brew taps vulns scripts msupdate adobe mas macos pipx uv vscode xxh sparkle unmanaged)
INSTALL_ORDER=(adobe mas brew msupdate pipx uv vscode macos)
declare -A LABELS=(
  [brew]="brew" [taps]="brew taps" [vulns]="brew vulnerabilities" [scripts]="Install scripts" [msupdate]="Microsoft AutoUpdate" [adobe]="Adobe" [mas]="App Store" [macos]="macOS"
  [pipx]="pipx" [uv]="uv tools" [vscode]="VS Code extensions" [xxh]="xxh remote binaries" [sparkle]="Sparkle apps" [unmanaged]="Apps without an updater"
)
MANUAL_SOURCES=" xxh sparkle unmanaged "
REVIEW_DAYS=14
SELF_UPDATING=("Google Chrome" "Brave Browser" Firefox Discord Signal Obsidian Docker Steam zoom.us Element "Autodesk Fusion" "iStat Menus")
MANAGED_IDS=('com.apple.*' 'com.microsoft.*' 'com.adobe.*' 'com.jamf*' '*ethz*' 'corp.sap.privileges' 'nl.root3.support')
BREW_APPS=""
CASK_TABLE=""  # token, app bundle name, auto_updates separated by \x1f, from brew info --installed
declare -A CASK_BY_APP=()  # lowercased app bundle name -> token|version|auto_updates, from Homebrew's API cache
declare -A HINTS=(
  [brew]="mac-outdated --install" [msupdate]="mac-outdated --install" [adobe]="mac-outdated --install" [mas]="mac-outdated --install"
  [macos]="mac-outdated --install" [pipx]="mac-outdated --install" [uv]="mac-outdated --install" [vscode]="mac-outdated --install"
  [sparkle]="open the app" [unmanaged]="brew install --cask --force …" [xxh]="terminal/install.sh --refresh-remote"
)
declare -A XXH_REPOS=([fish]=fish-shell/fish-shell [starship]=starship/starship [atuin]=atuinsh/atuin [bat]=sharkdp/bat [fastfetch]=fastfetch-cli/fastfetch)
XXH_HINT="bump the pin in terminal/remote-binaries.conf, then terminal/install.sh --refresh-remote"
RULE=$(printf '═%.0s' {1..58})
THIN=$(printf '─%.0s' {1..32})
COLOR=0

usage() {
  echo "mac-outdated $VERSION"
  cat <<'EOF'
usage: mac-outdated [--install]
  (none)     check every source, print what is outdated (no admin needed)
  --install  install every available update except third-party tap formulae, held for review (needs admin from the Privileges app, >= 15 min left)
  --version  print the version
  -h, --help this text
exit: 0 nothing outdated / all installed, 1 something outdated / something failed, 2 usage or admin precondition, 130 interrupted (Ctrl-C)

examples:
  mac-outdated             what is outdated, and the next command to run
  mac-outdated --install   after a click on Privileges (menu bar lock icon)
  logs: ~/.local/state/mac-outdated/logs/
EOF
}

# ── helpers ──────────────────────────────────────────────────────────────────
item() { printf '%s|%s|%s|%s|%s%s\n' "$1" "$2" "$3" "$4" "${5:-}" "${6:+|$6}"; }
# note <src> <text> [short result] [kind: ? unknown, – skipped, + by hand, i info only] [summary hint]: without a short result the note gets a section
note() { printf '%s|%s|%s||%s|%s\n' "$1" "${3:-}" "${4:-}" "$2" "${5:-}"; }
check_failed() { note "$1" "$2" "check failed" "!" "check failed"; }  # check_failed <src> <text>: the source could not be checked

setup_color() {
  COLOR=0
  if [ "${MAC_OUTDATED_COLOR:-}" = always ]; then COLOR=1
  elif [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then COLOR=1
  fi
}
c() {  # c <sgr code> <text>: bold 1, dim 2, red 31, green 32, yellow 33
  if [ "$COLOR" -eq 1 ]; then printf '\033[%sm%s\033[0m' "$1" "$2"; else printf '%s' "$2"; fi
}
header() { printf '%s · %s\n\n' "$(c 1 "$1")" "$(date '+%Y-%m-%d %H:%M')"; }
section() {  # section <title> <detail>
  printf '\n%s\n %s%s\n%s\n' "$RULE" "$(c 1 "$1")" "${2:+ · $2}" "$RULE"
}
progress_start() {  # progress_start <label>: dots to a fixed column, the result follows on the same line
  local dots=$((29 - ${#1}))
  [ "$dots" -ge 2 ] || dots=2
  printf '  %s %s ' "$1" "$(printf '.%.0s' $(seq "$dots"))"
}
row() {  # row <name> <installed> <latest> <name width> <version width> [tag]
  printf '    %s %s  →  %s%s\n' "$(c 33 "$(printf '%-*s' "$4" "$1")")" "$(c 2 "$(printf '%-*s' "$5" "$2")")" "$(c 33 "$3")" "${6:+  $(c 33 "$6")}"
}
summary_row() {  # summary_row <label> <count> <hint> [count colour, default yellow]
  printf '  %-28s%s%s   %s\n' "$1" "$(printf '%*s' $((4 - ${#2})) '')" "$(c "${4:-33}" "$2")" "$(c 2 "$3")"
}

older() {  # older <installed> <latest>: installed is strictly newer than latest, brew _N revisions ignored
  local i=$1 l=$2
  [[ $i =~ ^(.*)_[0-9]+$ ]] && i=${BASH_REMATCH[1]}
  [[ $l =~ ^(.*)_[0-9]+$ ]] && l=${BASH_REMATCH[1]}
  [ "$i" != "$l" ] && newer "$l" "$i"
}

plist_get() { plutil -extract "$2" raw -o - "$1" 2>/dev/null; }
app_version() { plist_get "$1/Contents/Info.plist" CFBundleShortVersionString; }

newer() {  # newer <installed> <latest>: latest is strictly newer
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$2" ]
}

all_apps() {
  local dirs d a
  IFS=: read -ra dirs <<< "$APP_DIRS"
  for d in "${dirs[@]}"; do
    for a in "$d"/*.app; do [ -d "$a" ] && printf '%s\n' "$a"; done
  done
}
find_app() {
  local a
  while IFS= read -r a; do
    [ "$(basename "$a" .app)" = "$1" ] && { printf '%s\n' "$a"; return 0; }
  done < <(all_apps)
  return 1
}
is_self_updating() {
  local s
  for s in "${SELF_UPDATING[@]}"; do [ "$s" = "$1" ] && return 0; done
  return 1
}
is_managed_id() {
  local p
  for p in "${MANAGED_IDS[@]}"; do
    # shellcheck disable=SC2053
    [[ $1 == $p ]] && return 0
  done
  return 1
}
is_brew_app() { grep -qixF "$1.app" <<< "$BREW_APPS"; }
load_brew_apps() {
  command -v brew >/dev/null || return 0
  local json
  json=$(brew info --cask --json=v2 --installed 2>/dev/null)
  BREW_APPS=$(jq -r '.casks[].artifacts[]? | objects | .app? // empty | .[] | strings' <<< "$json" 2>/dev/null)
  CASK_TABLE=$(jq -r '.casks[] | [.token, ([.artifacts[]? | objects | .app? // empty | .[] | strings][0] // ""), (.auto_updates == true | tostring)] | map(gsub("[[:cntrl:]]"; "")) | join("\u001f")' <<< "$json" 2>/dev/null)
}
cask_state() {  # cask_state <token> <latest>: prints "<state>|<app name>|<app version>", state stale (app already current), self (updates itself), install
  local token=$1 latest=${2%%,*} t app auto dirs d ver=""
  IFS=$'\x1f' read -r t app auto < <(awk -F$'\x1f' -v t="$token" '$1 == t' <<< "$CASK_TABLE")
  if [ -n "${app:-}" ]; then
    IFS=: read -ra dirs <<< "$APP_DIRS"
    for d in "${dirs[@]}"; do [ -d "$d/$app" ] && { ver=$(app_version "$d/$app"); break; }; done
  fi
  if [ -n "$ver" ] && ! newer "$ver" "$latest"; then echo "stale|${app%.app}|$ver"
  elif [ "${auto:-}" = true ]; then echo "self|${app%.app}|${ver:-?}"
  else echo "install|${app%.app}|$ver"
  fi
}
code_cmd() {
  local c
  c=$(command -v code) && { printf '%s\n' "$c"; return 0; }
  c="$HOME/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
  [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
  return 1
}

# ── log: the terminal gets the output as it comes, the log every line without colour codes ──
# a line starting with \x1f goes to the log only (folded tool output)
# shellcheck disable=SC2016
SPLITTER='
$SIG{INT} = "IGNORE";
open(my $log, ">>", $ARGV[0]) or exit 1;
select((select($log), $| = 1)[0]);
my ($bol, $hide, $line) = (1, 0, "");
sub logline { my $l = shift; $l =~ s/\e\[[0-9;?]*[A-Za-z]//g; $l =~ s/\r(?!\n)/\n/g; print $log $l; }
while (sysread(STDIN, my $buf, 65536)) {
  my $out = "";
  for my $part (split /(?<=\n)/, $buf) {
    if ($bol && substr($part, 0, 1) eq "\x1f") { $hide = 1; $part = substr($part, 1); }
    $out .= $part unless $hide;
    $line .= $part;
    if ($part =~ /\n\z/) { logline($line); $line = ""; $bol = 1; $hide = 0; } else { $bol = 0; }
  }
  syswrite(STDOUT, $out) if length $out;
}
logline($line) if length $line;
'
start_log() {  # start_log <check|install>: from here on stdout and stderr also go to the log
  local base n=1
  (umask 077; mkdir -p "$LOG_DIR") 2>/dev/null && chmod 700 "$LOG_DIR" 2>/dev/null || return 0
  base="$LOG_DIR/$(date +%Y-%m-%d-%H%M%S)"
  LOG="$base-$1.log"
  until (set -C; umask 077; : > "$LOG") 2>/dev/null; do
    [ -e "$LOG" ] && [ "$n" -lt 100 ] || { LOG=""; return 0; }
    n=$((n + 1)); LOG="$base-$n-$1.log"
  done
  local logs=("$LOG_DIR"/*.log)
  [ "${#logs[@]}" -le "$LOG_KEEP" ] || rm -f -- "${logs[@]:0:${#logs[@]}-LOG_KEEP}"
  exec {OUT_FD}>&1 {ERR_FD}>&2
  exec > >(trap '' INT; exec perl -e "$SPLITTER" "$LOG") 2>&1
  LOG_PID=$!
  log_only "mac-outdated $VERSION · $1 · $(date '+%Y-%m-%d %H:%M:%S')"
}
tmpfile() { mktemp "${TMP_DIR:-${TMPDIR:-/tmp}}/mac-outdated.XXXXXX"; }  # in the run's dir, so on_exit also removes files made in subshells
on_exit() {
  finish_log
  [ -z "$TMP_DIR" ] || rm -rf -- "$TMP_DIR"
}
finish_log() {  # waits up to 5 s for the log writer, then names the log as the last line
  [ -n "$LOG_PID" ] || return 0
  log_only "end $(date +%H:%M:%S), ${SECONDS}s total"
  exec >&"$OUT_FD"
  exec 2>&"$ERR_FD"
  local i=0
  while kill -0 "$LOG_PID" 2>/dev/null && [ "$i" -lt 250 ]; do sleep 0.02; i=$((i + 1)); done
  printf 'log: %s\n' "$LOG"
}

# ── check_<src>: print src|name|installed|latest|note lines ──────────────────
untrusted_taps() {  # reads brew's stderr, prints the taps named after "The following taps are not trusted:"
  awk '
    /The following taps are not trusted:/ {
      on = 1; rest = $0; sub(/.*not trusted:[ \t]*/, "", rest)
      n = split(rest, t, /[ ,]+/); for (i = 1; i <= n; i++) if (t[i] ~ /^[^\/ ]+\/[^\/ ]+$/) print t[i]
      next
    }
    on {
      line = $0; sub(/^[ \t]*([-*][ \t]+)?/, "", line); sub(/[ \t]+$/, "", line)
      if (line ~ /^[^\/ ]+\/[^\/ ]+$/) print line; else on = 0
    }' | sort -u
}
tap_formulae() {  # tap_formulae <tap>: installed formulae of the tap as <tap>/<name>, also when installed under the tap's old name
  local tap=$1 installed
  installed=$(brew list --formula --full-name 2>/dev/null)
  {
    grep "^$tap/" <<< "$installed"
    brew tap-info --json "$tap" 2>/dev/null | jq -r '.[0].formula_names[]?' 2>/dev/null \
      | while IFS= read -r f; do grep -qxE "([^/]+/[^/]+/)?${f##*/}" <<< "$installed" && printf '%s\n' "$f"; done
  } | sort -u
}
third_party_formulae() {  # base names of formulae installed from a tap other than homebrew's, also under the tap's old name
  brew list --formula --full-name 2>/dev/null | awk -F/ 'NF == 3 && $1 != "homebrew" { print $3 }'
}
is_listed() { grep -qxF "$2" <<< "$1"; }  # is_listed <lines> <line>
review_text() {  # review_text <name> <installed> <latest>: what a held formula's reviewer needs
  local name=$1 inst=${2%_*} latest=$3 info url home repo="" tag="" link age date secs days
  info=$(brew info --json=v2 --formula "$name" 2>/dev/null) || info=""
  url=$(jq -r '.formulae[0].urls.stable.url // empty' <<< "$info" 2>/dev/null)
  home=$(jq -r '.formulae[0].homepage // empty' <<< "$info" 2>/dev/null)
  link=${home:-unknown}
  age="release date unknown"
  if [[ $url =~ ^https://github\.com/([^/]+/[^/]+)/(releases/download/([^/]+)/|archive/refs/tags/([^/]+)$|archive/([^/]+)$) ]]; then
    repo=${BASH_REMATCH[1]}
    tag=${BASH_REMATCH[3]:-${BASH_REMATCH[4]:-${BASH_REMATCH[5]}}}
    tag=${tag%.tar.gz}; tag=${tag%.zip}
    link="https://github.com/$repo/compare/${tag//$latest/$inst}...$tag"
    date=$(curl -fsSL --max-time 10 "https://api.github.com/repos/$repo/commits/$tag" 2>/dev/null | jq -r '.commit.committer.date // empty' 2>/dev/null)
    if [ -n "$date" ] && secs=$(date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$date" +%s 2>/dev/null); then
      days=$(( ($(date +%s) - secs) / 86400 ))
      age="released $days days ago"
      [ "$days" -ge "$REVIEW_DAYS" ] || age+=", wait $((REVIEW_DAYS - days)) more days"
    fi
  fi
  printf '%s %s → %s, third-party tap, held for review: %s · changes: %s · then: brew upgrade %s' "${name##*/}" "$2" "$latest" "$age" "$link" "$name"
}
check_vulns() {
  command -v brew >/dev/null || { note vulns "brew not installed" "skipped (brew not installed)" – "install brew"; return; }
  local json line
  json=$(brew vulns --json 2>/dev/null)  # exits 1 when it finds something
  jq -e '.findings | type == "array"' <<< "$json" >/dev/null 2>&1 || { note vulns "brew vulns gave no result" "could not check" "?" "run brew vulns"; return; }
  local found=""
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    found=1
    note vulns "$line"
  done < <(jq -r '.findings | map(select(.vulnerabilities | length > 0)) | sort_by(.formula) | .[]
    | (.vulnerabilities | map(.severity | ascii_downcase)) as $s
    | "\(.formula) \(.version): " + (["critical", "high", "medium", "low", "unknown"]
        | map(. as $l | ($s | map(select(. == $l)) | length) as $n | select($n > 0) | "\($n) \($l)") | join(", "))' <<< "$json")
  [ -n "$found" ] || { note vulns "no known vulnerabilities" "none known" =; return; }
  note vulns "details: brew vulns · $(jq '((.skipped_formulae // []) | length) + ((.unscanned_formulae // {}) | length)' <<< "$json") packages not scanned · not counted as outdated" "" i
}
check_brew() {
  command -v brew >/dev/null || { note brew "brew not installed" "skipped (brew not installed)" – "install brew"; return; }
  local json err tap list third
  err=$(tmpfile)
  brew update --quiet >/dev/null 2>"$err" || note brew "brew update failed, the list may be stale"
  json=$(brew outdated --greedy --json=v2 2>>"$err") || { rm -f "$err"; check_failed brew "brew outdated failed"; return; }
  while IFS= read -r tap; do
    list=$(tap_formulae "$tap" | tr '\n' ' ')
    note brew "brew ignores untrusted tap $tap (its formulae get no updates): brew trust --formula ${list% }" "" + "brew trust (see brew section)"
  done < <(untrusted_taps < "$err")
  rm -f "$err"
  third=$(third_party_formulae)
  local lines s name inst latest kind state app ver
  lines=$(jq -r '(.formulae | map(. + {kind: "formula"})) + (.casks | map(. + {kind: "cask"})) | .[] | select(.pinned | not)
    | "brew|\(.name)|\(.installed_versions | if type == "array" then last else . end)|\(.current_version)|\(.kind)"' <<< "$json") \
    || { check_failed brew "could not read brew outdated output"; return; }
  while IFS='|' read -r s name inst latest kind; do
    [ -n "$s" ] || continue
    if [ "$kind" = cask ]; then
      IFS='|' read -r state app ver < <(cask_state "$name" "$latest")
      case $state in
        stale) note brew "$name: app already at $ver (brew's record is stale)" "" i; continue ;;
        self) [ "$ver" != "?" ] || ver=$inst; item brew "${app:-$name}" "$ver" "${latest%%,*}" open; continue ;;
      esac
    elif is_listed "$third" "${name##*/}"; then
      note brew "$(review_text "$name" "$inst" "$latest")" "" + "review, then brew upgrade ${name##*/}"
      continue
    fi
    item brew "$name" "$inst" "$latest" "$kind"
  done <<< "$lines"
}

starts_with() { awk -v p="$2" 'index($0, p) == 1 { f = 1 } END { exit !f }' <<< "$1"; }  # starts_with <lines> <prefix>: a line starts with it
moved_tap_used() {  # moved_tap_used <installed full names> <taps> <tap dir>: installed under a tap name no longer tapped (renamed owner), file in <tap dir>
  local name
  while IFS= read -r name; do
    [[ $name == */*/* ]] || continue
    grep -qxF "${name%/*}" <<< "$2" && continue
    [ -n "$(find "$3" -maxdepth 2 -name "${name##*/}.rb" -print -quit 2>/dev/null)" ] && return 0
  done <<< "$1"
  return 1
}
check_taps() {  # third-party taps nothing is installed from or without a commit in 2 years; reads the tap's files only, never loads a formula
  command -v brew >/dev/null || { note taps "brew not installed" "skipped (brew not installed)" – "install brew"; return; }
  local taps installed tap dir ct why now
  taps=$(brew tap 2>/dev/null | tr '[:upper:]' '[:lower:]') || { check_failed taps "brew tap failed"; return; }
  installed=$({ brew list --formula --full-name; brew list --cask --full-name; } 2>/dev/null | tr '[:upper:]' '[:lower:]')
  now=$(date +%s)
  while IFS= read -r tap; do
    case $tap in ""|homebrew/core|homebrew/cask) continue ;; esac
    dir=$(brew --repo "$tap" 2>/dev/null)
    why=""
    starts_with "$installed" "$tap/" || moved_tap_used "$installed" "$taps" "$dir" || why="nothing installed from it"
    ct=$(git -C "$dir" log -1 --format=%ct 2>/dev/null)
    [[ $ct =~ ^[0-9]+$ ]] && [ $((now - ct)) -gt $((2 * 365 * 86400)) ] && why+="${why:+, }no commit since $(date -r "$ct" +%Y-%m-%d)"
    [ -z "$why" ] || note taps "$tap: $why: brew untap $tap" "" + "brew untap $tap"
  done <<< "$taps"
}

# shellcheck disable=SC2016
TAP_REFS='
for my $f (@ARGV) {
  open(my $h, "<", $f) or next;
  while (<$h>) {
    next if /^\s*#/;
    for my $seg (split /&&|\|\||[;|)]/) {
      next unless $seg =~ /\bbrew\s+(?:install|reinstall|upgrade|tap)\b(.*)/;
      my $rest = $1;
      while ($rest =~ m{(?:^|[\s"\x27])([A-Za-z0-9][\w.-]*)/([\w.-]+)(?:/[\w.@+\$-]+)?(?=[\s"\x27]|$)}g) {
        my ($o, $t) = (lc $1, lc $2);
        $t =~ s/^homebrew-//;
        print "$f\t$o/$t\n" unless $o eq "homebrew";
      }
    }
  }
}
'
check_scripts() {  # the repo's install scripts naming a tap that is not tapped: brew install <owner>/<tap>/<name> or brew tap <owner>/<tap>
  command -v brew >/dev/null || { note scripts "brew not installed" "skipped (brew not installed)" – "install brew"; return; }
  [ -d "$REPO_ROOT" ] || { note scripts "repo not found: $REPO_ROOT" "repo not found"; return; }
  local taps f file tap files=()
  taps=$(brew tap 2>/dev/null | tr '[:upper:]' '[:lower:]') || { check_failed scripts "brew tap failed"; return; }
  while IFS= read -r -d '' f; do files+=("$f"); done < <(find "$REPO_ROOT" \( -name .git -o -name tests -o -name fixtures -o -name node_modules \) -prune \
    -o -type f \( -name '*.sh' -o -name 'install*' \) -print0)
  [ "${#files[@]}" -gt 0 ] || return 0
  while IFS=$'\t' read -r file tap; do
    grep -qxF "$tap" <<< "$taps" && continue
    note scripts "${file#"$REPO_ROOT"/} names tap $tap, which is not tapped: fix the script" "" + "fix the script"
  done < <(perl -e "$TAP_REFS" -- "${files[@]}" | sort -u)
}

declare -A MAU_APPS=(  # msupdate app ID -> app bundle name
  [XCEL2019]="Microsoft Excel" [MSWD2019]="Microsoft Word" [PPT32019]="Microsoft PowerPoint" [OPIM2019]="Microsoft Outlook"
  [ONMC2019]="Microsoft OneNote" [ONDR18]=OneDrive [MSAU04]="Microsoft AutoUpdate" [WDAV00]="Microsoft Defender"
  [WDAVCONSUMER]="Microsoft Defender" [TEAMS21]="Microsoft Teams" [TEAMS10]="Microsoft Teams classic" [EDGE01]="Microsoft Edge"
  [IMCP01]="Company Portal" [MSCP10]="Microsoft Copilot" [MSRD10]="Windows App"
)
parse_msupdate() {  # prints name|latest|app ID; entries are "<ID>  <title> Update <version> (<build>)", "<name> (<version>)" or "<name>" with a "Version:" line
  sed -e $'s/\033\\[[0-9;]*[A-Za-z]//g' | tr '\r' '\n' | awk '
    function flush() {
      if (name != "") print name "|" (tv != "" ? tv : fv != "" ? fv : build != "" ? build : "?") "|" id
      name = ""; tv = ""; fv = ""; build = ""; id = ""
    }
    /Updates available:/ { on = 1; next }
    !on { next }
    { sub(/^[ \t]+/, ""); sub(/[ \t]+$/, "") }
    $0 == "" || /^Update Assistant/ || /^No updates/ { next }
    /^Version:/ { sub(/^Version:[ \t]*/, ""); split($0, f, " "); fv = f[1]; next }
    /^Application ID:/ { if (id == "") { id = $0; sub(/^Application ID:[ \t]*/, "", id) } next }
    /^[A-Za-z][A-Za-z ]*:/ { next }
    {
      flush(); name = $0
      if (match(name, /^[A-Z][A-Za-z0-9]+(\t|  )[ \t]*/)) { id = substr(name, 1, RLENGTH); sub(/[ \t]+$/, "", id); name = substr(name, RLENGTH + 1) }
      if (match(name, / \([^)]*\)$/)) { build = substr(name, RSTART + 2, RLENGTH - 3); name = substr(name, 1, RSTART - 1) }
      if (match(name, / Update [0-9][0-9.]*$/)) { tv = substr(name, RSTART + 8); name = substr(name, 1, RSTART - 1) }
    }
    END { flush() }'
}
check_msupdate() {
  [ -x "$MSUPDATE" ] || { note msupdate "Microsoft AutoUpdate not installed" "skipped (msupdate not installed)" – "install Microsoft AutoUpdate"; return; }
  local out name version id app inst
  out=$("$MSUPDATE" --list 2>&1) || { check_failed msupdate "msupdate --list failed"; return; }
  while IFS='|' read -r name version id; do
    [ -n "$name" ] || continue
    name=${MAU_APPS[${id^^}]:-$name}
    inst=""
    if [ "${id^^}" = MSAU04 ]; then inst=$(app_version "${MSUPDATE%/Contents/MacOS/*}")
    elif app=$(find_app "$name"); then inst=$(app_version "$app")
    fi
    item msupdate "$name" "${inst:-?}" "$version"
  done < <(parse_msupdate <<< "$out")
}

check_adobe() {
  [ -x "$RUM" ] || { note adobe "RemoteUpdateManager not installed" "skipped (RemoteUpdateManager not installed)" – "install RemoteUpdateManager"; return; }
  local out rc
  out=$("$RUM" --action=list 2>&1); rc=$?
  if grep -q "not launched with Admin" <<< "$out"; then
    note adobe "mac-outdated --install updates Adobe apps" "checked during --install"; return
  fi
  awk '
    /^\*+/ { on = 0 }
    /Following .*[Uu]pdates are applicable/ { on = 1; next }
    on && /^[ \t]*- / {
      sub(/^[ \t]*- /, ""); n = split($0, p, "/")
      if (n >= 2) print "adobe|" p[1] "|?|" p[2] "|"; else print "adobe|" $0 "|?|update|"
    }' <<< "$out"
  [ "$rc" -eq 0 ] || grep -q "Following" <<< "$out" || check_failed adobe "RemoteUpdateManager --action=list failed (exit $rc)"
}

check_mas() {
  command -v mas >/dev/null || { note mas "mas not installed: brew install mas" "skipped (mas not installed)" – "brew install mas"; return; }
  local json
  json=$(mas outdated --json 2>/dev/null) || { check_failed mas "mas outdated failed"; return; }
  jq -r 'select(type == "object" and .newVersion != null and (.name // "") != "")
    | "mas|\(.name)|\(.version // "?")|\(.newVersion)|"' <<< "$json" \
    || check_failed mas "could not read mas outdated output"
}

check_macos() {
  [ -x "$SOFTWAREUPDATE" ] || { note macos "softwareupdate not found" "skipped (softwareupdate not found)" – "softwareupdate missing"; return; }
  local out current
  out=$("$SOFTWAREUPDATE" --list 2>&1) || { check_failed macos "softwareupdate --list failed"; return; }
  current=$(sw_vers -productVersion 2>/dev/null)
  awk -v cur="$current" '
    /Title: / {
      t = $0; sub(/.*Title: /, "", t); sub(/, Version: .*/, "", t)
      v = $0; sub(/.*Version: /, "", v); sub(/,.*/, "", v)
      inst = (t ~ /^macOS/ && cur != "") ? cur : "?"
      print "macos|" t "|" inst "|" v "|" ($0 ~ /Action: restart/ ? "restart required" : "")
    }' <<< "$out"
}

check_pipx() {
  command -v pipx >/dev/null || { note pipx "pipx not installed" "skipped (pipx not installed)" – "brew install pipx"; return; }
  local json rc venv pkg inst latest
  json=$(pipx list --json 2>/dev/null); rc=$?
  jq -e '.venvs | type == "object"' <<< "$json" >/dev/null 2>&1 || { check_failed pipx "pipx list failed"; return; }
  [ "$rc" -eq 0 ] || note pipx "pipx reports a broken package: run pipx reinstall-all"
  while IFS=$'\t' read -r venv pkg inst src; do
    [ -n "$venv" ] || continue
    [[ "$src" == /* || "$src" == .* || "$src" == file:* ]] && continue  # local path install, nothing to look up
    latest=$(pipx runpip "$venv" index versions "$pkg" 2>/dev/null | head -n 1 | sed -nE 's/^.*\((.+)\)$/\1/p')
    [ -n "$latest" ] || { note pipx "$pkg: latest version lookup failed"; continue; }
    newer "$inst" "$latest" && item pipx "$pkg" "$inst" "$latest"
  done < <(jq -r '.venvs | to_entries[] | [.key, .value.metadata.main_package.package, .value.metadata.main_package.package_version, (.value.metadata.main_package.package_or_url // "")] | @tsv' <<< "$json")
}

check_uv() {
  command -v uv >/dev/null || { note uv "uv not installed" "skipped (uv not installed)" – "brew install uv"; return; }
  local out
  out=$(uv tool list --outdated 2>/dev/null) || { check_failed uv "uv tool list --outdated failed"; return; }
  grep -q '^[^- ]' <<< "$out" || { note uv "no uv tools installed" "none installed" =; return; }
  sed -nE 's/^([^ -][^ ]*) v([^ ]+) \[latest: ([^]]+)\]$/uv|\1|\2|\3|/p' <<< "$out"
}

check_vscode() {
  local code n
  code=$(code_cmd) || { note vscode "VS Code CLI not found" "skipped (code not found)" – "install the code CLI"; return; }
  local list ext
  list=$("$code" --list-extensions --show-versions 2>/dev/null | grep '@')
  n=$(grep -c . <<< "$list")
  note vscode "$n extensions, mac-outdated --install updates them" "$n extensions, updated during --install"
  while IFS= read -r ext; do
    [ -n "$ext" ] && note vscode "${ext%@*}" "" l "${ext##*@}"
  done <<< "$list"
}

github_latest() {  # github_latest <owner/repo>: tag of the latest release; the API first, then the release page redirect (no API rate limit)
  local tag
  tag=$(curl -fsSL --max-time 10 "https://api.github.com/repos/$1/releases/latest" 2>/dev/null | jq -r '.tag_name // empty' 2>/dev/null)
  [ -n "$tag" ] || tag=$(curl -fsSL --max-time 10 -o /dev/null -w '%{url_effective}' "https://github.com/$1/releases/latest" 2>/dev/null | sed -n 's|.*/releases/tag/||p')
  printf '%s' "$tag"
}
check_xxh() {  # the VERSIONS file of each store under ~/.xxh/arch (written by terminal/install.sh) vs GitHub's latest release
  local d arch tool ver repo latest n out="" rows="" stores=()
  for d in "$HOME"/.xxh/arch/*/; do [ -d "$d" ] && stores+=("${d%/}"); done
  [ "${#stores[@]}" -gt 0 ] || { note xxh "no remote binaries under ~/.xxh/arch" "none stored"; return; }
  for d in "${stores[@]}"; do
    arch=${d##*/}
    if [ ! -f "$d/VERSIONS" ]; then
      out+=$(note xxh "$arch: versions not recorded: run terminal/install.sh --refresh-remote" "" + "terminal/install.sh --refresh-remote")$'\n'
      continue
    fi
    while read -r tool ver _; do
      [ -n "$tool" ] && [ -n "${ver:-}" ] && rows+="$tool $ver $arch"$'\n'
    done < "$d/VERSIONS"
  done
  while read -r tool; do
    [ -n "$tool" ] || continue
    repo=${XXH_REPOS[$tool]:-}
    [ -n "$repo" ] || { out+=$(note xxh "$tool: no release source known" "" i)$'\n'; continue; }
    latest=$(github_latest "$repo")
    [ -n "$latest" ] || { check_failed xxh "GitHub release lookup failed for $repo (offline or rate limited)"; return; }
    latest=${latest#v}
    n=$(awk -v t="$tool" '$1 == t { print $2 }' <<< "$rows" | sort -u | grep -c .)
    while read -r _ ver arch; do
      newer "$ver" "$latest" || continue
      if [ "$n" -gt 1 ]; then out+=$(item xxh "$tool ($arch)" "$ver" "$latest")$'\n'
      else out+=$(item xxh "$tool" "$ver" "$latest")$'\n'; break
      fi
    done < <(awk -v t="$tool" '$1 == t' <<< "$rows")
  done < <(awk '!seen[$1]++ { print $1 }' <<< "$rows")
  printf '%s' "$out"
}

appcast_latest() {  # prints "S <newest shortVersionString>" and "V <newest version>" lines, beta channels skipped
  awk '
    { buf = buf " " $0 }
    END {
      n = split(buf, items, "</item>")
      for (i = 1; i <= n; i++) {
        s = items[i]
        if (s !~ /<item/ || s ~ /sparkle:channel/) continue
        if (match(s, /sparkle:shortVersionString="[^"]+"/) || match(s, /<sparkle:shortVersionString>[^<]+</))
          print "S " substr(s, RSTART + 28, RLENGTH - 29)
        if (match(s, /sparkle:version="[^"]+"/) || match(s, /<sparkle:version>[^<]+</))
          print "V " substr(s, RSTART + 17, RLENGTH - 18)
      }
    }' | sort -k1,1 -k2V | awk '{ last[$1] = $2 } END { for (k in last) print k, last[k] }'
}
check_sparkle() {
  local app name plist feed xml kind value short="" build="" inst latest
  while IFS= read -r app; do
    [ -d "$app/Contents/Frameworks/Sparkle.framework" ] || continue
    name=$(basename "$app" .app)
    is_brew_app "$name" && continue
    is_self_updating "$name" && continue
    plist="$app/Contents/Info.plist"
    feed=$(plist_get "$plist" SUFeedURL)
    if [ -z "$feed" ]; then
      inst=$(app_version "$app")
      [ -n "$inst" ] && command -v brew >/dev/null && cask_item sparkle "$name" "$inst"
      continue
    fi
    xml=$(curl -fsSL --max-time 10 "$feed" 2>/dev/null) || { note sparkle "$name: appcast not reachable"; continue; }
    short="" build=""
    while read -r kind value; do
      case $kind in S) short=$value ;; V) build=$value ;; esac
    done < <(appcast_latest <<< "$xml")
    if [ -n "$short" ]; then inst=$(app_version "$app"); latest=$short
    elif [ -n "$build" ]; then inst=$(plist_get "$plist" CFBundleVersion); latest=$build
    else note sparkle "$name: no version in appcast"; continue
    fi
    [ -n "$inst" ] && newer "$inst" "$latest" && item sparkle "$name" "$inst" "$latest" open
  done < <(all_apps)
}

cask_token() { printf '%s' "$1" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9.-'; }
# shellcheck disable=SC2016
CASK_MAP_JQ='
  def norm: ascii_downcase | sub("\\.app$"; "") | gsub(" "; "-") | gsub("[^a-z0-9.-]"; "");
  def list: if type == "array" then .[] else . end;
  .payload | fromjson
  | if type == "object" then
      .casks | (if type == "object" then to_entries | map(.key as $k | .value | .token = $k) else . end) | .[]
      | {token, version, auto: (.auto_updates == true), off: (.disable_args != null),
         apps: [.raw_artifacts[]? | select(.[0] == ":app") | .[1][]? | strings],
         dels: [.raw_artifacts[]? | select(.[0] == ":uninstall") | .[1] | list | objects | .[":delete"]? // empty | list | strings]}
    else
      .[] | {token, version, auto: (.auto_updates == true), off: (.disabled == true),
         apps: [.artifacts[]? | objects | .app? // empty | .[] | strings],
         dels: [.artifacts[]? | objects | .uninstall? // empty | list | objects | .delete? // empty | list | strings]}
    end
  | select(.off | not) | . as $c
  | ([.apps[] | {app: ., rank: 0}] + [.dels[] | select(test("^/Applications/[^/]+\\.app$")) | {app: sub("^/Applications/"; ""), rank: 10}])[]
  | .rank += (if $c.token == (.app | norm) then 0 elif ($c.token | contains("@")) then 2 else 1 end)
  | {key: (.app | ascii_downcase), rank, v: "\($c.token)|\($c.version)|\($c.auto)"}
'
load_cask_map() {  # fills CASK_BY_APP from the newest API cache file; stays empty without one
  command -v brew >/dev/null || return 0
  local cache f="" p key v
  cache=$(brew --cache 2>/dev/null) || return 0
  for p in "$cache"/api/internal/packages.*.jws.json; do
    [ -f "$p" ] && { [ -z "$f" ] || [ "$p" -nt "$f" ]; } && f=$p
  done
  [ -n "$f" ] || f="$cache/api/cask.jws.json"
  [ -f "$f" ] || return 0
  while IFS=$'\t' read -r key v; do
    [ -n "$key" ] && CASK_BY_APP[$key]=$v
  done < <(jq -r "[$CASK_MAP_JQ] | group_by(.key) | .[] | min_by(.rank) | [.key, .v] | @tsv" "$f" 2>/dev/null)
}
cask_for_app() {  # cask_for_app <app name>: prints "token|version|auto_updates" of the cask installing <app name>.app
  local name=$1 token json
  if [ "${#CASK_BY_APP[@]}" -gt 0 ]; then
    [ -n "${CASK_BY_APP[${name,,}.app]:-}" ] && printf '%s\n' "${CASK_BY_APP[${name,,}.app]}"
    return
  fi
  token=$(cask_token "$name")
  [ -n "$token" ] || return 1
  json=$(brew info --cask --json=v2 "$token" 2>/dev/null) || return 1
  jq -r --arg a "$name.app" --arg t "$token" '.casks[0] | select([.artifacts[]? | objects | .app? // empty | .[] | strings] | index($a)) | "\(.token // $t)|\(.version)|\(.auto_updates == true)"' <<< "$json" 2>/dev/null
}
cask_item() {  # cask_item <src> <app name> <installed>: an item when the app's cask is newer; auto-updating casks open to update
  local token version auto latest
  IFS='|' read -r token version auto < <(cask_for_app "$2")
  latest=${version%%,*}
  [ -n "${token:-}" ] && [ -n "$latest" ] && [ "$latest" != latest ] || return 0
  newer "$3" "$latest" || return 0
  if [ "$auto" = true ]; then item "$1" "$2" "$3" "$latest" open
  else item "$1" "$2" "$3" "$latest" "brew install --cask --force $token"
  fi
}
check_unmanaged() {
  command -v brew >/dev/null || return 0
  local app name id inst
  while IFS= read -r app; do
    name=$(basename "$app" .app)
    [ -d "$app/Contents/Frameworks/Sparkle.framework" ] && continue
    [ -d "$app/Contents/_MASReceipt" ] && continue
    is_brew_app "$name" && continue
    is_self_updating "$name" && continue
    id=$(plist_get "$app/Contents/Info.plist" CFBundleIdentifier)
    is_managed_id "$id" && continue
    inst=$(app_version "$app")
    [ -n "$inst" ] || continue
    cask_item unmanaged "$name" "$inst"
  done < <(all_apps)
}

mark_self_updating() {  # mark_self_updating <lines>: items of SELF_UPDATING apps become open-to-update items
  local line s name inst latest
  while IFS= read -r line; do
    IFS='|' read -r s name inst latest _ <<< "$line"
    if [ -n "$latest" ] && is_self_updating "$name"; then item "$s" "$name" "$inst" "$latest" open
    else printf '%s\n' "$line"
    fi
  done <<< "$1"
}
open_to_update() {  # open_to_update <open items> <info notes without a section>: outdated self-updating apps, then the other self-updating apps
  local items=$1 s found=() name inst latest extra hint nw=24 vw=1 n
  for s in "${SELF_UPDATING[@]}"; do
    find_app "$s" >/dev/null && ! is_brew_app "$s" && ! grep -qF "|$s|" <<< "$items" && found+=("$s")
  done
  if [ -n "$items" ]; then
    n=$(grep -c . <<< "$items")
    section "Open to update" "$n"
    printf '  %s\n' "$(c 33 "These apps update themselves on start: open them by hand.")"
    while IFS='|' read -r s name inst latest extra hint; do
      [ "${#name}" -le "$nw" ] || nw=${#name}
      [ "${#inst}" -le "$vw" ] || vw=${#inst}
    done <<< "$items"
    while IFS='|' read -r s name inst latest extra hint; do row "$name" "$inst" "$latest" "$nw" "$vw"; done <<< "$items"
  elif [ "${#found[@]}" -gt 0 ] || [ -n "$2" ]; then
    printf '\n'
  fi
  [ "${#found[@]}" -eq 0 ] || printf '  %s\n' "$(c 2 "also update themselves on start: $(IFS=,; sed 's/,/, /g' <<< "${found[*]}")")"
  while IFS='|' read -r s name inst latest extra hint; do
    [ -n "$s" ] && printf '  %s\n' "$(c 2 "$extra")"
  done <<< "$2"
}

# ── check mode ───────────────────────────────────────────────────────────────
declare -A N_ITEMS N_HAND N_OPEN N_INFO N_NOTES N_FAILED N_LIST SHORT KIND SHINT HHINT

analyze() {  # analyze <src> <lines>: fills the counters and the short result of the first note that has one
  local src=$1 s name inst latest extra hint
  N_ITEMS[$src]=0 N_HAND[$src]=0 N_OPEN[$src]=0 N_INFO[$src]=0 N_NOTES[$src]=0 N_FAILED[$src]=0 N_LIST[$src]=0 SHORT[$src]="" KIND[$src]="" SHINT[$src]="" HHINT[$src]=""
  while IFS='|' read -r s name inst latest extra hint; do
    [ -n "$s" ] || continue
    if [ -n "$latest" ] && [ "$extra" = open ]; then N_OPEN[$src]=$((N_OPEN[$src] + 1)); continue; fi
    if [ -n "$latest" ]; then N_ITEMS[$src]=$((N_ITEMS[$src] + 1)); continue; fi
    if [ "$inst" = i ]; then N_INFO[$src]=$((N_INFO[$src] + 1)); continue; fi
    if [ "$inst" = l ]; then N_LIST[$src]=$((N_LIST[$src] + 1)); continue; fi
    if [ "$inst" = + ]; then
      N_HAND[$src]=$((N_HAND[$src] + 1))
      [[ "${HHINT[$src]}" == *"$hint"* ]] || HHINT[$src]+="${HHINT[$src]:+ · }$hint"
      continue
    fi
    N_NOTES[$src]=$((N_NOTES[$src] + 1))
    [ "$inst" != "!" ] || N_FAILED[$src]=1
    if [ -n "$name" ] && [ -z "${SHORT[$src]}" ]; then SHORT[$src]=$name KIND[$src]=$inst SHINT[$src]=$hint; fi
  done <<< "$2"
}
result_text() {  # result_text <src>: the coloured short result for the progress line
  local src=$1
  if [ "${N_ITEMS[$src]}" -gt 0 ] || [ "${N_HAND[$src]}" -gt 0 ]; then c 33 "$(counts_text "$src")"
  elif [ "${N_OPEN[$src]}" -gt 0 ] && [[ $MANUAL_SOURCES == *" $src "* ]]; then c 33 "${N_OPEN[$src]} to open"
  elif [ -n "${SHORT[$src]}" ]; then
    case ${KIND[$src]} in
      "!") c 31 "${SHORT[$src]}" ;;
      =) c 32 "${SHORT[$src]}" ;;
      "") c 2 "${SHORT[$src]}" ;;
      *) c 33 "${SHORT[$src]}" ;;
    esac
  elif [ "${N_NOTES[$src]}" -gt 0 ]; then c 33 "${N_NOTES[$src]} note$([ "${N_NOTES[$src]}" -gt 1 ] && echo s)"
  else c 32 "up to date"
  fi
}

counts_text() {  # counts_text <src>: "N outdated · M by hand"
  local src=$1 t=""
  [ "${N_ITEMS[$src]}" -eq 0 ] || t="${N_ITEMS[$src]} outdated"
  [ "${N_HAND[$src]}" -eq 0 ] || t+="${t:+ · }${N_HAND[$src]} by hand"
  printf '%s' "$t"
}
detail_section() {  # detail_section <src> <lines>
  local src=$1 block=$2 s name inst latest extra hint n=0 nw=24 vw=1 tag group
  while IFS='|' read -r s name inst latest extra hint; do
    [ -n "$latest" ] && [ "$extra" != open ] || continue
    [ "${#name}" -le "$nw" ] || nw=${#name}
    [ "${#inst}" -le "$vw" ] || vw=${#inst}
  done <<< "$block"
  if [ "${N_ITEMS[$src]}" -gt 0 ] || [ "${N_HAND[$src]}" -gt 0 ]; then n=$(counts_text "$src"); else n="${N_NOTES[$src]} note$([ "${N_NOTES[$src]}" -gt 1 ] && echo s)"; fi
  section "${LABELS[$src]}" "$n"
  local groups=("")
  [ "$src" = brew ] && groups=(formula cask)
  for group in "${groups[@]}"; do
    if [ -n "$group" ] && grep -q "|$group\$" <<< "$block"; then
      case $group in formula) printf '  formulae\n' ;; cask) printf '  casks\n' ;; esac
    fi
    while IFS='|' read -r s name inst latest extra hint; do
      [ -n "$latest" ] || continue
      [ "$extra" != open ] || continue
      [ "$src" != brew ] || [ "$extra" = "$group" ] || continue
      tag=""
      case $src in
        brew) older "$inst" "$latest" && tag="(older version: brew moved to the $(cut -d. -f1,2 <<< "$latest") line)" ;;
        macos) [ -z "$extra" ] || tag="($extra)" ;;
      esac
      row "$name" "$inst" "$latest" "$nw" "$vw" "$tag"
      case $src in sparkle|unmanaged) [ -z "$extra" ] || printf '      %s\n' "$(c 33 "$extra")" ;; esac
    done <<< "$block"
  done
  [ "$src" != xxh ] || [ "${N_ITEMS[$src]}" -eq 0 ] || printf '  %s\n' "$(c 33 "$XXH_HINT")"
  while IFS='|' read -r s name inst latest extra hint; do
    [ -z "$latest" ] && [ -n "$s" ] && printf '  %s\n' "$(c "$([ "$inst" = + ] && echo 33 || echo 2)" "$extra")"
  done <<< "$block"
}

list_section() {  # list_section <src> <lines>: name and version of each listed entry (nothing to do)
  local s name inst latest extra hint w=24
  while IFS='|' read -r s name inst latest extra hint; do
    [ "$inst" = l ] && [ "${#extra}" -gt "$w" ] && w=${#extra}
  done <<< "$2"
  section "${LABELS[$1]}" "${N_LIST[$1]} installed"
  while IFS='|' read -r s name inst latest extra hint; do
    [ "$inst" = l ] && printf '    %s  %s\n' "$(printf '%-*s' "$w" "$extra")" "$(c 2 "$hint")"
  done <<< "$2"
}

check_mode() {
  command -v jq >/dev/null || { echo "jq not found: brew install jq" >&2; exit 2; }
  load_brew_apps
  load_cask_map
  header "mac-outdated v$VERSION"
  local src block
  declare -A LINES
  for src in "${SOURCES[@]}"; do
    progress_start "${LABELS[$src]}"
    block=$(mark_self_updating "$("check_$src")")
    LINES[$src]=$block
    analyze "$src" "$block"
    printf '%s\n' "$(result_text "$src")"
  done

  local outdated=0 manual=0 installable=0 nfailed=0 nopen=0 n open="" info=""
  for src in "${SOURCES[@]}"; do
    n=${N_ITEMS[$src]}
    nfailed=$((nfailed + N_FAILED[$src]))
    nopen=$((nopen + N_OPEN[$src]))
    outdated=$((outdated + n + N_HAND[$src] + N_OPEN[$src]))
    manual=$((manual + N_HAND[$src] + N_OPEN[$src]))
    if [[ $MANUAL_SOURCES == *" $src "* ]]; then manual=$((manual + n)); else installable=$((installable + n)); fi
    open+=$(grep -E '^([^|]*\|){4}open$' <<< "${LINES[$src]}")$'\n'
    if [ "$n" -gt 0 ] || [ "${N_HAND[$src]}" -gt 0 ] || { [ "${N_NOTES[$src]}" -gt 0 ] && [ -z "${SHORT[$src]}" ]; }; then
      detail_section "$src" "${LINES[$src]}"
    else
      info+=$(grep -E '^[^|]*\|\|i\|\|' <<< "${LINES[$src]}")$'\n'
    fi
    [ "${N_LIST[$src]}" -eq 0 ] || list_section "$src" "${LINES[$src]}"
  done
  open_to_update "$(grep . <<< "$open" | sort -f -t'|' -k2,2)" "$(grep . <<< "$info")"

  section "Summary" ""
  for src in "${SOURCES[@]}"; do
    if [ "${N_ITEMS[$src]}" -gt 0 ]; then summary_row "${LABELS[$src]}" "${N_ITEMS[$src]}" "${HINTS[$src]}"
    elif [ "${KIND[$src]}" = "?" ] || [ "${KIND[$src]}" = "–" ] || [ "${KIND[$src]}" = "!" ]; then summary_row "${LABELS[$src]}" "${KIND[$src]}" "${SHINT[$src]}" "$([ "${KIND[$src]}" = "!" ] && echo 31 || echo 33)"
    fi
    [ "${N_HAND[$src]}" -eq 0 ] || summary_row "${LABELS[$src]} by hand" "${N_HAND[$src]}" "${HHINT[$src]}"
  done
  [ "$nopen" -eq 0 ] || summary_row "open to update" "$nopen" "open the app (updates on start)"
  if [ "$outdated" -gt 0 ] || [ "$nfailed" -gt 0 ]; then
    local rest=""
    [ "$outdated" -eq 0 ] || rest="$installable via --install · $manual by hand"
    [ "$nfailed" -eq 0 ] || rest+="${rest:+ · }$nfailed check$([ "$nfailed" -gt 1 ] && echo s) failed"
    printf '  %s\n' "$THIN"
    summary_row total "$outdated" "$rest" "$([ "$outdated" -gt 0 ] && echo 33 || echo 31)"
  else
    printf '  %s\n' "$(c 32 "everything up to date")"
  fi
  [ "$installable" -gt 0 ] && printf '\n  %s\n' "$(c 1 "next: mac-outdated --install")"
  [ "$nfailed" -gt 0 ] || { mkdir -p "$(dirname "$STAMP")" && date +%s > "$STAMP"; }
  [ "$outdated" -eq 0 ] && [ "$nfailed" -eq 0 ]
}

# ── admin precondition ───────────────────────────────────────────────────────
admin_minutes_left() {  # parses "Administrator privileges expire in N minute(s)" from the status text
  [[ $1 =~ expire\ in\ ([0-9]+)\ minute ]] && echo "${BASH_REMATCH[1]}"
}
is_admin_status() { [[ $1 == *"has administrator privileges"* || $1 == *"Administrator privileges have been assigned"* ]]; }
require_admin() {
  local status left answer
  [ -x "$PRIVILEGESCLI" ] || { echo "Privileges app not found: $PRIVILEGESCLI"; return 1; }
  status=$("$PRIVILEGESCLI" --status 2>&1)
  if ! is_admin_status "$status"; then
    echo "Click Privileges (lock icon in the menu bar), then rerun mac-outdated --install"
    return 1
  fi
  if left=$(admin_minutes_left "$status"); then
    if [ "$left" -lt "$MIN_ADMIN_MINUTES" ]; then
      echo "only $left min of admin left, need $MIN_ADMIN_MINUTES: revert and click Privileges again"
      return 1
    fi
    echo "admin: $left min left"
  else
    echo "admin time left unknown"
    printf 'Continue anyway? [y/N] '
    read -r answer || answer=""
    [[ $answer == [yY]* ]] || return 1
  fi
}

still_admin() {  # before each sudo step; unknown time passes, the start already checked it
  local status left
  status=$("$PRIVILEGESCLI" --status 2>&1)
  is_admin_status "$status" || { STEP_STATUS=expired; return 1; }
  left=$(admin_minutes_left "$status") || return 0
  [ "$left" -ge "$MIN_STEP_ADMIN_MINUTES" ] || { STEP_STATUS="expires $left"; return 1; }
}

# ── install_<src>: the tool's exit code; a step that does not run sets STEP_STATUS and returns 0 ──
install_macos() {
  [ -x "$SOFTWAREUPDATE" ] || { STEP_STATUS=missing; return 0; }
  local list after rc t="" text="" still tty=1
  list=$("$SOFTWAREUPDATE" --list 2>&1) || { rc=$?; printf '%s\n' "$list" | indent; return "$rc"; }
  grep -q 'No new software available' <<< "$list" && { STEP_STATUS=uptodate; return 0; }
  still_admin || return 0
  { echo "softwareupdate --list before:"; printf '%s\n' "$list"; } | log_lines
  if { [ -t 0 ] || [ "$STDIN_TTY" = 1 ]; } && [ -x "$SCRIPT_CMD" ] && t=$(tmpfile); then
    to_terminal "$SCRIPT_CMD" -q "$t" "$SUDO" "$SOFTWAREUPDATE" --install --all; rc=$?
    # in raw mode Ctrl-C goes into the pty, not to our INT trap
    { [ "$rc" -eq 2 ] || [ "$rc" -gt 128 ]; } && LC_ALL=C grep -qE $'\x03|\\^C' "$t" && rc=130
    text=$(LC_ALL=C tr -d '\004\010' < "$t" | tr '\r' '\n' | sed -e $'s/\x1b\\[[0-9;?]*[A-Za-z]//g' -e 's/\^D//g' | grep -v '^[[:space:]]*$' | uniq)
    rm -f "$t"
    { echo "softwareupdate --install output:"; printf '%s\n' "$text"; } | log_lines
  else
    to_terminal "$SUDO" "$SOFTWAREUPDATE" --install --all; rc=$?; tty=0
  fi
  [ "$rc" -eq 0 ] || return "$rc"
  after=$("$SOFTWAREUPDATE" --list 2>&1) || { STEP_STATUS=unverified; return 0; }
  { echo "softwareupdate --list after:"; printf '%s\n' "$after"; } | log_lines
  still=$(labels_still_offered "$list" "$after")
  [ -n "$still" ] || return 0
  [ "$tty" -eq 1 ] || { STEP_STATUS=unconfirmed; return 1; }
  local staged=() other=() entry title
  while IFS= read -r t; do
    entry=$(grep -A1 -xF "* Label: $t" <<< "$list")
    title=$(sed -n 's/^[[:space:]]*Title: \([^,]*\),.*/\1/p' <<< "$entry")
    if grep -q 'Action: restart' <<< "$entry" && { grep -qi restart <<< "$text" || has_downloaded "$text" "$title"; }; then staged+=("$t"); else other+=("$t"); fi
  done <<< "$still"
  [ "${#staged[@]}" -eq 0 ] || MACOS_STAGED=$(join_labels "${staged[@]}")
  [ "${#other[@]}" -gt 0 ] || { STEP_STATUS=restart; return 0; }
  MACOS_FAILED=$(join_labels "${other[@]}")
  [ "${#staged[@]}" -gt 0 ] || MACOS_FAILED+="; owner password empty or wrong?"
  STEP_STATUS=stilloffered
  return 1
}
has_downloaded() { [ -n "$2" ] && awk -v l="Downloaded: $2" '{ sub(/[[:space:]]+$/, "") } $0 == l { f = 1 } END { exit !f }' <<< "$1"; }  # has_downloaded <transcript> <title>
join_labels() { local out=$1 l; shift; for l in "$@"; do out+=", $l"; done; printf '%s' "$out"; }
to_terminal() {  # past the log pipe, so sudo puts the terminal in raw mode and its prompts stay hidden
  if [ -n "$OUT_FD" ]; then "$@" 1>&"$OUT_FD" 2>&"$ERR_FD"; else "$@"; fi
}
log_lines() { local l; while IFS= read -r l; do log_only "$l"; done; }
labels_still_offered() {  # labels_still_offered <list before> <list after>: labels from before still offered after, one per line
  local l out=""
  while IFS= read -r l; do grep -qF "* Label: $l" <<< "$2" && out+="${out:+$'\n'}$l"; done < <(sed -n 's/^\* Label: //p' <<< "$1")
  printf '%s' "$out"
}
run_noting() {  # run_noting <pattern> <command…>: the command's exit code; on success, output matching <pattern> (nothing updated) marks the step up to date
  local pattern=$1 out rc
  shift
  RUN_OUT=""
  out=$(tmpfile) || { "$@"; return; }
  "$@" 2>&1 | tee -i "$out"
  rc=${PIPESTATUS[0]}
  [ "$rc" -ne 0 ] || ! grep -qE "$pattern" "$out" || STEP_STATUS=uptodate
  RUN_OUT=$(cat "$out")
  rm -f "$out"
  return "$rc"
}
install_adobe() {
  [ -x "$RUM" ] || { STEP_STATUS=missing; return 0; }
  still_admin || return 0
  run_noting 'No new applicable Updates' "$SUDO" "$RUM" --action=install
}
install_brew() {
  command -v brew >/dev/null || { STEP_STATUS=missing; return 0; }
  command -v jq >/dev/null || { echo "jq not found: brew install jq"; return 1; }
  local json casks=() token latest state rc=0 r third name upgrades=() selfs=() held=() did=0
  brew update || { echo "brew update failed, upgrading anyway"; rc=1; }
  third=$(third_party_formulae)
  if json=$(brew outdated --formula --json=v2 2>/dev/null); then
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      if is_listed "$third" "${name##*/}"; then echo "${name##*/}: third-party tap, held for review (see mac-outdated)"; held+=("${name##*/}"); else upgrades+=("$name"); fi
    done < <(jq -r '.formulae[] | select(.pinned | not) | .name' <<< "$json")
    if [ "${#upgrades[@]}" -gt 0 ]; then
      did=1
      brew upgrade --formula "${upgrades[@]}" || rc=$?
    fi
  else
    echo "brew outdated failed, no formula upgraded"
    rc=1
  fi
  load_brew_apps
  for name in "${held[@]}"; do hand "$name: third-party tap, held for review (mac-outdated lists it)"; done
  json=$(brew outdated --cask --json=v2 2>/dev/null) || { echo "brew outdated --cask failed"; return 1; }
  while IFS=$'\t' read -r token latest; do
    [ -n "$token" ] || continue
    IFS='|' read -r state _ < <(cask_state "$token" "$latest")
    case $state in
      install) casks+=("$token") ;;
      stale) echo "$token: app already current, brew's record is stale" ;;
      self) echo "$token: updates itself on start, open the app"; selfs+=("$token") ;;
    esac
  done < <(jq -r '.casks[] | select(.pinned | not) | [.name, .current_version] | @tsv' <<< "$json")
  if [ "${#casks[@]}" -gt 0 ]; then
    did=1
    brew upgrade --cask "${casks[@]}"; r=$?
    [ "$rc" -ne 0 ] || rc=$r
  fi
  if [ "${#selfs[@]}" -gt 0 ]; then
    r=$(printf ', %s' "${selfs[@]}")
    hand "${r:2}: open the app, it updates itself"
  fi
  [ "$did" -eq 1 ] || [ "$rc" -ne 0 ] || STEP_STATUS=uptodate
  return "$rc"
}
install_msupdate() {
  [ -x "$MSUPDATE" ] || { STEP_STATUS=missing; return 0; }
  local list rc
  list=$("$MSUPDATE" --list 2>&1) || { rc=$?; printf '%s\n' "$list"; return "$rc"; }
  [ -n "$(parse_msupdate <<< "$list")" ] || { STEP_STATUS=uptodate; return 0; }
  "$MSUPDATE" --install --wait 600
}
install_mas() {
  local mas
  mas=$(command -v mas) || { STEP_STATUS=missing; return 0; }
  mas=$(readlink -f "$mas") || { STEP_STATUS=missing; return 0; }
  local list rc
  list=$("$mas" outdated --json 2>&1) || { rc=$?; printf '%s\n' "$list"; echo "mas outdated failed, nothing upgraded"; return "$rc"; }
  grep -q newVersion <<< "$list" || { STEP_STATUS=uptodate; return 0; }
  still_admin || return 0
  [ "$(stat -f %u "$mas")" = 0 ] || echo "mas is owned by your user (Homebrew) and runs as root here: residual risk, see software-updates.md"
  "$SUDO" "$mas" upgrade
}
install_pipx() {
  command -v pipx >/dev/null || { STEP_STATUS=missing; return 0; }
  local rc pkg path
  run_noting 'No packages upgraded' pipx upgrade-all; rc=$?
  while IFS=$'\t' read -r pkg path; do
    [ -n "$path" ] || continue
    path=${path/#"$HOME"/\~}
    if [ -n "$pkg" ]; then hand "pipx $pkg: $path links elsewhere: rm it, then pipx reinstall $pkg"
    else hand "pipx: $path links elsewhere: rm it so pipx can link its own"; fi
  done < <(pipx_link_conflicts <<< "$RUN_OUT")
  return "$rc"
}
pipx_link_conflicts() {  # pipx wraps its warnings; prints "<package>\t<path>" per "File exists at" warning
  perl -0777 -ne 's/\n[ \t]*//g; my $p = ""; while (/upgrading ?(\S+?) ?from|File ?exists ?at ?(\S+?) ?and ?points ?to/gi) { if (defined $1) { $p = $1 } else { print "$p\t$2\n" } }'
}
install_uv() {
  command -v uv >/dev/null || { STEP_STATUS=missing; return 0; }
  run_noting 'Nothing to upgrade' uv tool upgrade --all
}
install_vscode() {
  local code
  code=$(code_cmd) || { STEP_STATUS=missing; return 0; }
  run_noting 'No extension to update' "$code" --update-extensions
}

FOLD_AFTER=5 FOLD_SHOW=3 FOLD_MODE="" FOLD_KEY="" FOLD_PREFIX="" FOLD_N=0 FOLD_PENDING=() FOLD_LAST=""
# more than FOLD_AFTER lines in a row fold on the terminal, the log keeps them all:
#   similar (same first word and ending): the first FOLD_SHOW, then a count
#   progress (same text before the first ":", e.g. "Update Assistant: …"): the first, a count, the last
fold_line() {  # fold_line <line>: blank lines are dropped
  local l=$1 plain first key prefix="" suffix
  plain=$l
  while [[ $plain =~ $'\033'\[[0-9\;?]*[A-Za-z] ]]; do plain=${plain/"${BASH_REMATCH[0]}"/}; done
  [[ $plain =~ [^[:space:]] ]] || return 0
  first=${plain%% *} suffix=$plain
  [[ $plain != *": "* ]] || suffix=${plain##*: }
  key="$first|$suffix"
  [[ $plain != *:* ]] || prefix=${plain%%:*}
  if [ "$FOLD_MODE" = similar ] && [ "$key" = "$FOLD_KEY" ]; then
    FOLD_N=$((FOLD_N + 1))
    if [ "$FOLD_N" -le "$FOLD_SHOW" ]; then printf '    %s\n' "$l"
    elif [ "$FOLD_N" -le "$FOLD_AFTER" ]; then FOLD_PENDING+=("$l")
    else
      for l in "${FOLD_PENDING[@]}" "$l"; do log_only "    $l"; done
      FOLD_PENDING=()
    fi
    return
  fi
  if [ -n "$prefix" ] && [ "$prefix" = "$FOLD_PREFIX" ] && { [ "$FOLD_MODE" = progress ] || [ "$FOLD_N" -eq 1 ]; }; then
    FOLD_MODE=progress FOLD_N=$((FOLD_N + 1))
    if [ "$FOLD_N" -le "$FOLD_AFTER" ]; then FOLD_PENDING+=("$l")
    else
      [ "${#FOLD_PENDING[@]}" -eq 0 ] || { for first in "${FOLD_PENDING[@]}"; do log_only "    $first"; done; FOLD_PENDING=(); }
      [ -z "$FOLD_LAST" ] || log_only "    $FOLD_LAST"
      FOLD_LAST=$l
    fi
    return
  fi
  fold_end
  FOLD_MODE=similar FOLD_KEY=$key FOLD_PREFIX=$prefix FOLD_N=1
  printf '    %s\n' "$l"
}
fold_end() {  # ends a run: the fold message (and for progress the last line), or the held-back lines when the run stayed short
  local l
  if [ "${FOLD_N:-0}" -le "$FOLD_AFTER" ]; then
    for l in "${FOLD_PENDING[@]}"; do printf '    %s\n' "$l"; done
  elif [ "$FOLD_MODE" = progress ]; then
    printf '    %s\n' "$(c 2 "… $((FOLD_N - 2)) progress lines (full output in log)")"
    printf '    %s\n' "$FOLD_LAST"
  else
    printf '    %s\n' "$(c 2 "… $((FOLD_N - FOLD_SHOW)) more similar lines (full output in log)")"
  fi
  FOLD_MODE="" FOLD_KEY="" FOLD_PREFIX="" FOLD_N=0 FOLD_PENDING=() FOLD_LAST=""
}
log_only() { [ -z "$LOG" ] || printf '\x1f%s\n' "$1"; }

indent() {  # indents tool output as it arrives; a line without newline (a prompt) shows after a second
  local line rc mid=0 part
  FOLD_MODE="" FOLD_KEY="" FOLD_PREFIX="" FOLD_N=0 FOLD_PENDING=() FOLD_LAST=""
  while :; do
    IFS= read -r -t 1 line; rc=$?
    [ "$rc" -eq 0 ] && line=${line%$'\r'}
    if [ "$rc" -eq 0 ]; then
      if [ "$mid" -eq 1 ]; then printf '%s\n' "${line//$'\r'/$'\n'    }"; mid=0; continue; fi
      while IFS= read -r part; do fold_line "$part"; done <<< "${line//$'\r'/$'\n'}"
    elif [ "$rc" -gt 128 ]; then
      [ -n "$line" ] || continue
      fold_end
      [ "$mid" -eq 1 ] || printf '    '
      printf '%s' "${line//$'\r'/$'\n'    }"; mid=1
    else
      fold_end
      if [ -n "$line" ]; then [ "$mid" -eq 1 ] || printf '    '; printf '%s\n' "${line//$'\r'/$'\n'    }"
      elif [ "$mid" -eq 1 ]; then printf '\n'
      fi
      return 0
    fi
  done
}

declare -A RESULT
STEP="" FAILED=0
BY_HAND=()
hand() { BY_HAND+=("$1"); }

install_summary() {
  local src r word n_inst=0 n_up=0 n_fail=0 n_skip=0 n_int=0 n_not=0
  section "Summary" ""
  for src in "${INSTALL_ORDER[@]}"; do
    r=${RESULT[$src]:-not run}
    case $r in
      installed*) n_inst=$((n_inst + 1)); word=$(c 32 "$r") ;;
      "up to date") n_up=$((n_up + 1)); word=$(c 32 "$r") ;;
      skipped*) n_skip=$((n_skip + 1)); word=$(c 33 "$r") ;;
      "some updates failed"*|"not verified"*) n_fail=$((n_fail + 1)); word=$(c 33 "$r") ;;
      interrupted) n_int=$((n_int + 1)); word=$(c 31 "$r") ;;
      "not run") n_not=$((n_not + 1)); word=$(c 31 "$r") ;;
      *) n_fail=$((n_fail + 1)); word=$(c 31 "$r") ;;
    esac
    printf '  %-26s%s\n' "${LABELS[$src]}" "$word"
  done
  printf '  %s\n' "$THIN"
  local parts=()
  [ "$n_inst" -eq 0 ] || parts+=("$n_inst installed")
  [ "$n_up" -eq 0 ] || parts+=("$n_up up to date")
  [ "$n_fail" -eq 0 ] || parts+=("$n_fail failed")
  [ "$n_skip" -eq 0 ] || parts+=("$n_skip skipped")
  [ "$n_int" -eq 0 ] || parts+=("$n_int interrupted")
  [ "$n_not" -eq 0 ] || parts+=("$n_not not run")
  local joined=${parts[0]-} i
  for i in "${parts[@]:1}"; do joined+=" · $i"; done
  printf '  %-26s%s\n' total "$joined"
  local failed=() h f
  for src in "${INSTALL_ORDER[@]}"; do
    r=${RESULT[$src]:-}
    case $r in
      failed*) failed+=("${LABELS[$src]} ${r#failed }") ;;
      "some updates failed"*) failed+=("${LABELS[$src]} (some updates failed)") ;;
      "not verified"*) failed+=("${LABELS[$src]} (not verified)") ;;
    esac
  done
  printf '\n'
  if [ "${#failed[@]}" -eq 0 ]; then printf '  %s\n' "$(c 32 '✓ nothing failed')"
  else
    joined=${failed[0]}
    for f in "${failed[@]:1}"; do joined+=", $f"; done
    printf '  %s\n' "$(c 31 "✗ failed: $joined")"
    [ -z "$LOG" ] || printf '    details: %s\n' "$LOG"
    printf '    rerun: mac-outdated --install\n'
  fi
  section "By hand" ""
  if [ "${#BY_HAND[@]}" -eq 0 ]; then printf '  %s\n' "nothing to do by hand"
  else for h in "${BY_HAND[@]}"; do printf '  %s\n' "$(c 33 "$h")"; done; fi
}

install_abort() {  # Ctrl-C or a step ending with 130: no further steps
  trap - INT
  [ -z "$STEP" ] || [ -n "${RESULT[$STEP]:-}" ] || RESULT[$STEP]=interrupted
  printf '\n  %s\n' "$(c 31 "interrupted — remaining steps not run")"
  install_summary
  exit 130
}

install_mode() {
  header "mac-outdated v$VERSION --install"
  require_admin || exit 2
  echo "  sudo asks again before a step when the last sudo was over a minute ago; the macOS step asks for your sudo password and then the owner password (both your login password)"
  "$SUDO" -v || { echo "sudo failed"; exit 2; }
  trap install_abort INT
  local src rc label word t0
  for src in "${INSTALL_ORDER[@]}"; do
    label=${LABELS[$src]}
    STEP=$src
    printf '\n%s\n' "$(c 1 "── $label")"
    STEP_STATUS=""
    t0=$SECONDS; log_only "step $src: start $(date +%H:%M:%S)"
    if [ "$src" = macos ]; then
      install_macos; rc=$?
    else
      "install_$src" > >(indent) 2>&1; rc=$?
      wait "$!"
    fi
    case $STEP_STATUS:$rc in
      uptodate:*) RESULT[$src]="up to date" ;;
      missing:*) RESULT[$src]="skipped ($src not installed)" ;;
      expired:*) RESULT[$src]="skipped (admin expired: click Privileges and rerun)"; FAILED=1
        hand "$label: skipped, admin expired: click Privileges, then mac-outdated --install" ;;
      expires*) RESULT[$src]="skipped (admin expires in ${STEP_STATUS#expires } min: click Privileges and rerun)"; FAILED=1
        hand "$label: skipped, admin expires in ${STEP_STATUS#expires } min: click Privileges, then mac-outdated --install" ;;
      restart:*) RESULT[$src]="installed, restart required"; hand "$MACOS_STAGED: restart the Mac when it suits you" ;;
      unverified:*) RESULT[$src]="installed (not verified: softwareupdate --list failed)" ;;
      stilloffered:*) RESULT[$src]="failed (still offered after install: $MACOS_FAILED)"; FAILED=1
        [ -z "$MACOS_STAGED" ] || hand "$MACOS_STAGED: restart the Mac when it suits you" ;;
      unconfirmed:*) RESULT[$src]="not verified (still offered, no terminal: restart if macOS asks, else rerun in a terminal)"; FAILED=1 ;;
      :0) RESULT[$src]=installed ;;
      :130) RESULT[$src]=interrupted ;;
      :2) if [ "$src" = adobe ]; then RESULT[$src]="some updates failed (Adobe exit 2: often an open Adobe app; see Adobe's RUM log)"
          else RESULT[$src]="failed (exit $rc)"; fi; FAILED=1 ;;
      *) RESULT[$src]="failed (exit $rc)"; FAILED=1 ;;
    esac
    log_only "step $src: end $(date +%H:%M:%S), $((SECONDS - t0))s, exit $rc, ${RESULT[$src]}"
    case ${RESULT[$src]} in
      installed*|"up to date") word=$(c 32 "${RESULT[$src]}") ;;
      skipped*|"some updates failed"*|"not verified"*) word=$(c 33 "${RESULT[$src]}") ;;
      *) word=$(c 31 "${RESULT[$src]}") ;;
    esac
    progress_start "$label"
    printf '%s\n' "$word"
    [ "${RESULT[$src]}" != interrupted ] || install_abort
  done
  STEP=""
  trap - INT
  install_summary
  exit "$FAILED"
}

setup_run() {
  setup_color
  TMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/mac-outdated.XXXXXX") || TMP_DIR=""
  trap on_exit EXIT
}
main() {
  if [ "$(id -u)" -eq 0 ]; then
    echo "run mac-outdated --install as your own user, not with sudo: it asks for your password itself (brew must not run as root)" >&2
    exit 2
  fi
  case "${1:-}" in
    "") setup_run; start_log check; check_mode; exit $? ;;
    --install) [ $# -eq 1 ] || { usage >&2; exit 2; }; setup_run; start_log install; install_mode ;;
    --version) [ $# -eq 1 ] || { usage >&2; exit 2; }; echo "mac-outdated $VERSION" ;;
    -h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

[ "${BASH_SOURCE[0]}" != "$0" ] || main "$@"
